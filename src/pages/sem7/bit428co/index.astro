---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { COURSES } from '../../../data/curriculum';
import ArrowLeft from 'lucide-astro/ArrowLeft';
import BookOpen from 'lucide-astro/BookOpen';
import Play from 'lucide-astro/Play';
import Clock from 'lucide-astro/Clock';
import Layers from 'lucide-astro/Layers';

const course = COURSES.find((c) => c.code === 'BIT428CO')!;
---

<BaseLayout
  title={`${course.code}: ${course.title}`}
  description={course.description}
>
  <div class="relative min-h-screen flex flex-col justify-between px-6 py-10 max-w-7xl mx-auto bg-slate-50 text-slate-900">
    <!-- Top Navigation -->
    <header class="pb-6 border-b-2 border-slate-200">
      <div class="flex items-center gap-3 mb-4">
        <a
          href="/"
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white border-2 border-slate-300 text-xs font-bold text-slate-800 hover:bg-slate-100 transition-all shadow-sm"
        >
          <ArrowLeft class="w-3.5 h-3.5" />
          <span>All Courses</span>
        </a>
        <div class="h-4 w-px bg-slate-300"></div>
        <span class="text-xs font-bold text-slate-600">{course.semester}</span>
      </div>

      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs font-mono font-bold px-2.5 py-0.5 rounded bg-amber-100 border border-amber-300 text-amber-900">
              {course.code}
            </span>
            <span class="text-xs font-bold px-2.5 py-0.5 rounded-full border bg-slate-100 border-slate-300 text-slate-800">
              {course.category}
            </span>
          </div>
          <h1 class="text-3xl font-extrabold text-slate-950 tracking-tight m-0">
            {course.title}
          </h1>
        </div>
      </div>
      <p class="text-sm text-slate-700 font-medium leading-relaxed mt-3 max-w-3xl">
        {course.description}
      </p>
    </header>

    <!-- Syllabus Unit Modules -->
    <main class="my-auto py-8 space-y-8">
      {course.units.length > 0 ? (
        <div class="space-y-6">
          {course.units.map((unit) => (
            <div class="p-6 rounded-xl bg-white border-2 border-slate-300 shadow-sm">
              <div class="flex items-center justify-between border-b-2 border-slate-100 pb-3 mb-4">
                <div class="flex items-center gap-2.5">
                  <span class="w-7 h-7 rounded-lg bg-amber-50 border border-amber-200 text-amber-900 font-mono font-bold text-xs flex items-center justify-center">
                    0{unit.number}
                  </span>
                  <h3 class="text-lg font-extrabold text-slate-950 m-0">{unit.title}</h3>
                </div>
                <span class="text-xs font-mono text-slate-500 font-bold">
                  {unit.topics.length} {unit.topics.length === 1 ? 'lecture' : 'lectures'}
                </span>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {unit.topics.map((topic) => (
                  <div class="p-4 rounded-lg bg-slate-50 border border-slate-200 flex flex-col justify-between">
                    <div>
                      <div class="flex items-center justify-between gap-2 mb-2">
                        <span class="text-xs font-bold text-amber-900">
                          Lecture 0{topic.lectureNumber}
                        </span>
                        <span class="text-xs font-mono text-slate-500 flex items-center gap-1">
                          <Clock class="w-3 h-3" />
                          {topic.duration}
                        </span>
                      </div>
                      <h4 class="text-sm font-bold text-slate-900 mb-1">{topic.title}</h4>
                      <p class="text-xs text-slate-600 font-medium leading-relaxed mb-3">
                        {topic.description}
                      </p>
                    </div>

                    <div>
                      <a
                        href={topic.path}
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-amber-700 hover:bg-amber-800 text-white text-xs font-bold transition-all shadow-sm"
                      >
                        <span>Open Presentation</span>
                        <Play class="w-3 h-3 fill-current" />
                      </a>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="p-8 rounded-xl bg-white border-2 border-slate-300 text-center max-w-lg mx-auto my-6 shadow-sm">
          <div class="w-10 h-10 rounded-full bg-slate-100 border-2 border-slate-300 text-slate-700 flex items-center justify-center mx-auto mb-3">
            <Layers class="w-5 h-5" />
          </div>
          <h3 class="text-base font-bold text-slate-950 mb-1">No lectures published yet</h3>
          <p class="text-xs text-slate-600 font-medium m-0">
            Lecture notes will appear here once published.
          </p>
        </div>
      )}
    </main>

    <!-- Footer -->
    <footer class="pt-6 border-t-2 border-slate-200 flex items-center justify-between text-xs text-slate-600 font-medium">
      <span>{course.code} · {course.title}</span>
      <span>{course.semester}</span>
    </footer>
  </div>
</BaseLayout>
