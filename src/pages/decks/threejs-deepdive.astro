---
import DeckLayout from '../../layouts/DeckLayout.astro';
import Slide from '../../components/slides/Slide.astro';
import Step from '../../components/slides/Step.astro';
import Card from '../../components/slides/Card.astro';
import ThreeCanvas from '../../components/three/ThreeCanvas.astro';
import SpeakerNotes from '../../components/slides/SpeakerNotes.astro';
import Box from 'lucide-astro/Box';
import Orbit from 'lucide-astro/Orbit';
import Activity from 'lucide-astro/Activity';
import Compass from 'lucide-astro/Compass';
import Move from 'lucide-astro/Move';
---

<DeckLayout
  title="Three.js 3D Visual Engine"
  description="Deep dive into interactive WebGL backgrounds and 3D slide components"
  initialScene="geometry"
>
  <!-- Slide 1: Cover -->
  <Slide id="cover" layout="cover" bgScene="geometry">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-cyan-500/20 border border-cyan-500/30 text-cyan-300 text-xs font-semibold uppercase tracking-wider mb-6">
        <Box class="w-3.5 h-3.5" />
        <span>Interactive Graphics</span>
      </div>
      <h1 class="text-gradient-cyan font-black text-6xl tracking-tight mb-4 leading-tight">
        Three.js 3D Visuals & Shaders
      </h1>
      <p class="text-xl text-slate-300 font-light max-w-2xl mb-8 leading-relaxed">
        Engage your audience with immersive WebGL backgrounds and interactive 3D models embedded directly in your slides.
      </p>
      <div class="flex items-center gap-4 text-xs font-mono text-slate-400">
        <span class="px-2.5 py-1 rounded bg-slate-900/80 border border-white/10">Move mouse for parallax</span>
        <span>•</span>
        <span>Press SPACE to advance</span>
      </div>
    </div>
    <SpeakerNotes>
      Point out how moving the cursor gently tilts and rotates the 3D wireframe geometries in the background.
    </SpeakerNotes>
  </Slide>

  <!-- Slide 2: Particle Wave Preset -->
  <Slide id="particles" title="Scene Preset: Particle Wave" subtitle="Undulating 3D mathematical sine waves" bgScene="particles">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center my-auto">
      <div class="space-y-4">
        <p class="text-slate-200 text-base leading-relaxed">
          The <strong>Particle Wave</strong> preset computes multi-frequency sine and cosine wave equations across a grid of 4,000+ points at 60 frames per second.
        </p>
        <Step effect="fade-up" index={1}>
          <div class="p-4 rounded-xl glass-panel border border-indigo-500/30">
            <h4 class="text-sm font-bold text-indigo-400 mb-1 flex items-center gap-2">
              <Activity class="w-4 h-4" />
              <span>Dynamic Color Interpolation</span>
            </h4>
            <p class="text-xs text-slate-300 m-0">
              Particle hues automatically morph across the color spectrum as you navigate through different slides.
            </p>
          </div>
        </Step>
      </div>

      <Step effect="zoom-in" index={2}>
        <Card title="Interactive Parallax" badge="Mouse Responsive" glow="indigo">
          <p class="text-sm text-slate-300">
            Move your cursor across the screen. The camera dynamically pans and shifts perspective to create an organic depth of field.
          </p>
        </Card>
      </Step>
    </div>
    <SpeakerNotes>
      Notice how switching to this slide transitioned the background smoothly to the Particle Wave preset.
    </SpeakerNotes>
  </Slide>

  <!-- Slide 3: Cyber Grid Preset -->
  <Slide id="cyber-grid" title="Scene Preset: Cyber Grid" subtitle="Retro-futuristic synthwave horizon" bgScene="grid">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 my-auto">
      <Card title="Infinite Grid" badge="WebGL" glow="rose">
        <p class="text-sm text-slate-300">
          Two staggered GridHelpers create seamless continuous terrain movement toward a glowing horizon.
        </p>
      </Card>

      <Card title="Speed Throttle" badge="Slide Hook" glow="cyan">
        <p class="text-sm text-slate-300">
          When you press Next, the engine briefly boosts flight velocity from 60 to 160 units/s to emphasize transitions.
        </p>
      </Card>

      <Card title="Starfield Points" badge="BufferGeometry" glow="amber">
        <p class="text-sm text-slate-300">
          600 randomized stars in the background with individual HSL color variances.
        </p>
      </Card>
    </div>
    <SpeakerNotes>
      Explain how the grid gives a strong sense of momentum during tech or gaming talks.
    </SpeakerNotes>
  </Slide>

  <!-- Slide 4: Constellation Preset -->
  <Slide id="constellation" title="Scene Preset: Constellation" subtitle="Proximity-based node network" bgScene="constellation">
    <div class="max-w-2xl my-auto">
      <p class="text-slate-200 text-base leading-relaxed mb-6">
        The <strong>Constellation</strong> preset simulates interconnected data nodes drifting in 3D space. Dynamic lines are calculated and drawn in real-time between nodes within proximity.
      </p>
      <div class="grid grid-cols-2 gap-4">
        <div class="p-4 rounded-xl glass-panel">
          <div class="text-2xl font-bold text-cyan-400 mb-1">110 Nodes</div>
          <div class="text-xs text-slate-400">Independently drifting vectors</div>
        </div>
        <div class="p-4 rounded-xl glass-panel">
          <div class="text-2xl font-bold text-indigo-400 mb-1">Real-time Alpha</div>
          <div class="text-xs text-slate-400">Line opacity scaled by distance</div>
        </div>
      </div>
    </div>
    <SpeakerNotes>
      Perfect backdrop for presentations about networks, distributed systems, AI neural networks, and graph databases.
    </SpeakerNotes>
  </Slide>

  <!-- Slide 5: Embedded 3D Canvas Widget -->
  <Slide id="embedded-3d" title="Inline Interactive 3D Objects" subtitle="Embed manipulable 3D models directly inside your slide layout" bgScene="none">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center my-auto">
      <div>
        <p class="text-slate-300 text-sm leading-relaxed mb-4">
          In addition to background scenes, you can drop standalone <code>&lt;ThreeCanvas /&gt;</code> widgets into any slide layout.
        </p>
        <div class="space-y-3">
          <div class="flex items-center gap-2 text-xs text-slate-300">
            <Move class="w-4 h-4 text-cyan-400" />
            <span><strong>Click and drag</strong> the 3D model on the right to rotate it live during your talk.</span>
          </div>
          <div class="flex items-center gap-2 text-xs text-slate-300">
            <Orbit class="w-4 h-4 text-indigo-400" />
            <span>Automatic subtle ambient rotation when idle.</span>
          </div>
        </div>
      </div>

      <div class="flex justify-center">
        <ThreeCanvas model="knot" color="#6366f1" height="300px" />
      </div>
    </div>
    <SpeakerNotes>
      Demonstrate clicking and dragging the 3D Torus Knot model directly in the browser to show live interactivity.
    </SpeakerNotes>
  </Slide>
</DeckLayout>
