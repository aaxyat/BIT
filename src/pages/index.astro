---
import BaseLayout from '../layouts/BaseLayout.astro';
import CourseCard from '../components/curriculum/CourseCard.astro';
import { COURSES } from '../data/curriculum';
import Presentation from 'lucide-astro/Presentation';
import Layers from 'lucide-astro/Layers';
import Keyboard from 'lucide-astro/Keyboard';
import BookOpen from 'lucide-astro/BookOpen';
---

<BaseLayout title="BIT Course Lectures" description="Course notes and lecture presentations for Bachelor of Information Technology.">
  <div class="relative min-h-screen flex flex-col justify-between px-6 py-10 max-w-7xl mx-auto bg-slate-50 text-slate-900">
    <!-- Header -->
    <header class="flex items-center justify-between pb-6 border-b-2 border-slate-200">
      <div class="flex items-center gap-3">
        <div class="p-2.5 rounded-lg bg-indigo-100 border-2 border-indigo-300 text-indigo-900">
          <Presentation class="w-6 h-6" />
        </div>
        <div>
          <span class="text-xs font-mono uppercase tracking-widest text-indigo-900 font-extrabold block">Bachelor of Information Technology</span>
          <h1 class="text-xl font-extrabold text-slate-950 tracking-tight m-0">Course Lecture Repository</h1>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="my-auto py-8">
      <div class="max-w-3xl mb-8">
        <h2 class="text-slate-950 font-black text-3xl sm:text-4xl tracking-tight leading-tight mb-2">
          Academic Course Decks
        </h2>
        <p class="text-sm text-slate-700 font-medium leading-relaxed max-w-2xl">
          Complete, self-contained projected lecture notes organized by semester, subject, and syllabus unit.
        </p>
      </div>

      <!-- Course Grid -->
      <section class="space-y-6">
        <div class="flex items-center justify-between">
          <h3 class="text-xl font-extrabold text-slate-950 tracking-tight flex items-center gap-2">
            <BookOpen class="w-5 h-5 text-indigo-700" />
            <span>Active Courses ({COURSES.length})</span>
          </h3>
          <span class="text-xs font-mono text-slate-600 font-bold">Select a subject to view syllabus</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {COURSES.map((course) => (
            <CourseCard course={course} />
          ))}
        </div>
      </section>

      <!-- Keyboard Shortcuts Quick Guide -->
      <section class="mt-12 p-5 rounded-xl bg-white border-2 border-slate-300 shadow-sm">
        <div class="flex items-center gap-3">
          <div class="p-2.5 rounded-lg bg-indigo-50 text-indigo-900 border border-indigo-200">
            <Keyboard class="w-5 h-5" />
          </div>
          <div>
            <h4 class="text-sm font-bold text-slate-950 mb-0.5">Presentation Controls</h4>
            <p class="text-xs text-slate-700 font-medium m-0">
              Inside any slide deck: <kbd class="px-1.5 py-0.5 rounded bg-slate-100 border border-slate-300 text-indigo-900 font-mono text-xs font-bold">SPACE</kbd> next slide, <kbd class="px-1.5 py-0.5 rounded bg-slate-100 border border-slate-300 text-indigo-900 font-mono text-xs font-bold">S</kbd> speaker notes, <kbd class="px-1.5 py-0.5 rounded bg-slate-100 border border-slate-300 text-indigo-900 font-mono text-xs font-bold">ESC</kbd> overview grid, <kbd class="px-1.5 py-0.5 rounded bg-slate-100 border border-slate-300 text-indigo-900 font-mono text-xs font-bold">?</kbd> shortcuts guide.
            </p>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="pt-6 border-t-2 border-slate-200 flex items-center justify-between text-xs text-slate-600 font-medium">
      <span>Bachelor of Information Technology (BIT)</span>
      <span>Semesters 4, 5, 7, 8</span>
    </footer>
  </div>
</BaseLayout>
