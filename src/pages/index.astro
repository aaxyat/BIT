---
import BaseLayout from '../layouts/BaseLayout.astro';
import DeckCard from '../components/decks/DeckCard.astro';
import Presentation from 'lucide-astro/Presentation';
import Sparkles from 'lucide-astro/Sparkles';
import Layers from 'lucide-astro/Layers';
import BookOpen from 'lucide-astro/BookOpen';
import CheckCircle2 from 'lucide-astro/CheckCircle2';
import Keyboard from 'lucide-astro/Keyboard';

const decks = [
  {
    title: 'CS 3840: Three.js Core Architecture & WebGL Pipeline',
    description: 'Complete 1-hour university teaching reference notes covering the WebGL state machine, Scene Graph hierarchy, Quaternion spatial mathematics, BufferGeometry memory layouts, PBR illumination models, and GPU buffer lifecycle optimization.',
    slug: 'threejs-fundamentals',
    category: 'Computer Graphics',
    slideCount: 12,
    duration: '60 min',
    glow: 'indigo' as const,
    featured: true,
  },
];
---

<BaseLayout
  title="Lecture Slide Platform: Complete Teaching Notes"
  description="High-density, projector-ready classroom lecture presentations built with Astro and Reveal.js."
>
  <div class="relative min-h-screen flex flex-col justify-between px-6 py-10 max-w-7xl mx-auto bg-slate-50 text-slate-900">
    <!-- Header -->
    <header class="flex items-center justify-between pb-6 border-b-2 border-slate-200">
      <div class="flex items-center gap-3">
        <div class="p-2.5 rounded-lg bg-indigo-100 border-2 border-indigo-300 text-indigo-900">
          <Presentation class="w-6 h-6" />
        </div>
        <div>
          <span class="text-xs font-mono uppercase tracking-widest text-indigo-900 font-extrabold block">Classroom Teaching System</span>
          <h1 class="text-xl font-extrabold text-slate-950 tracking-tight m-0">Lecture Slide Platform</h1>
        </div>
      </div>

      <div class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-full bg-white border-2 border-slate-300 text-xs font-bold text-slate-800 shadow-sm">
        <CheckCircle2 class="w-4 h-4 text-emerald-600" />
        <span>Projector & Ambient Light Optimized</span>
      </div>
    </header>

    <!-- Main Hero & Catalog -->
    <main class="my-auto py-8">
      <div class="max-w-3xl mb-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-100 border border-indigo-300 text-indigo-900 text-xs font-extrabold uppercase tracking-wider mb-4">
          <BookOpen class="w-3.5 h-3.5" />
          <span>Complete Teaching Notes On Screen</span>
        </div>
        <h2 class="text-slate-950 font-black text-3xl sm:text-5xl tracking-tight leading-tight mb-4">
          Rigorous Lecture Slides Built for Real Classrooms.
        </h2>
        <p class="text-base text-slate-700 font-medium leading-relaxed mb-6 max-w-2xl">
          High-density reference presentations designed to ensure that a student who missed the lecture can master 100% of the material directly from the slides.
        </p>

        <!-- Defensive Specs -->
        <div class="grid grid-cols-3 gap-4 max-w-xl">
          <div class="p-4 rounded-lg bg-white border-2 border-slate-300 shadow-sm">
            <div class="text-2xl font-extrabold text-slate-950">100%</div>
            <div class="text-xs text-slate-600 font-bold">Content Coverage</div>
          </div>
          <div class="p-4 rounded-lg bg-white border-2 border-slate-300 shadow-sm">
            <div class="text-2xl font-extrabold text-indigo-900">16pt+</div>
            <div class="text-xs text-slate-600 font-bold">Legible Font Scale</div>
          </div>
          <div class="p-4 rounded-lg bg-white border-2 border-slate-300 shadow-sm">
            <div class="text-2xl font-extrabold text-teal-800">≥ 7:1</div>
            <div class="text-xs text-slate-600 font-bold">Optical Contrast</div>
          </div>
        </div>
      </div>

      <!-- Decks Grid -->
      <section class="space-y-6">
        <div class="flex items-center justify-between">
          <h3 class="text-xl font-extrabold text-slate-950 tracking-tight flex items-center gap-2">
            <Layers class="w-5 h-5 text-indigo-700" />
            <span>Course Lecture Decks</span>
          </h3>
          <span class="text-xs font-mono text-slate-600 font-bold">Select a deck to present</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {decks.map((deck) => (
            <DeckCard {...deck} />
          ))}
        </div>
      </section>

      <!-- Keyboard Shortcuts Quick Guide -->
      <section class="mt-12 p-6 rounded-xl bg-white border-2 border-slate-300 shadow-sm">
        <div class="flex items-center gap-3">
          <div class="p-3 rounded-lg bg-indigo-100 text-indigo-900 border border-indigo-200">
            <Keyboard class="w-6 h-6" />
          </div>
          <div>
            <h4 class="text-base font-extrabold text-slate-950 mb-0.5">Presenter Shortcuts</h4>
            <p class="text-xs text-slate-700 font-medium m-0">
              Press <kbd class="px-1.5 py-0.5 rounded bg-slate-100 border border-slate-300 text-indigo-900 font-mono text-xs font-bold">SPACE</kbd> for next slide, <kbd class="px-1.5 py-0.5 rounded bg-slate-100 border border-slate-300 text-indigo-900 font-mono text-xs font-bold">S</kbd> for Speaker Notes, <kbd class="px-1.5 py-0.5 rounded bg-slate-100 border border-slate-300 text-indigo-900 font-mono text-xs font-bold">ESC</kbd> for Overview Grid, and <kbd class="px-1.5 py-0.5 rounded bg-slate-100 border border-slate-300 text-indigo-900 font-mono text-xs font-bold">?</kbd> for help.
            </p>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="pt-6 border-t-2 border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-600 font-bold">
      <div>
        <span>Astro Lecture Slides Platform</span>
      </div>
      <div>
        <span>Clean Path URLs Enabled</span>
      </div>
    </footer>
  </div>
</BaseLayout>
