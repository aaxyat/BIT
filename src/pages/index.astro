---
import BaseLayout from '../layouts/BaseLayout.astro';
import DeckCard from '../components/decks/DeckCard.astro';
import Layers from 'lucide-astro/Layers';
import Keyboard from 'lucide-astro/Keyboard';

interface DeckItem {
  title: string;
  description: string;
  slug: string;
  category: string;
  slideCount: number;
  duration: string;
  glow?: 'indigo' | 'cyan' | 'rose' | 'amber';
  featured?: boolean;
}

const decks: DeckItem[] = [];
---

<BaseLayout title="BIT — Presentations" description="Course notes and presentations.">
  <div class="relative min-h-screen flex flex-col justify-between px-6 py-10 max-w-7xl mx-auto bg-slate-50 text-slate-900">
    <!-- Header -->
    <header class="flex items-center justify-between pb-6 border-b-2 border-slate-200">
      <div>
        <h1 class="text-2xl font-extrabold text-slate-950 tracking-tight m-0">BIT</h1>
        <p class="text-xs text-slate-600 font-semibold m-0">Presentations & Course Notes</p>
      </div>
    </header>

    <!-- Main Content -->
    <main class="my-auto py-8">
      <div class="max-w-3xl mb-8">
        <h2 class="text-slate-950 font-black text-3xl sm:text-4xl tracking-tight leading-tight mb-2">
          Course Notes
        </h2>
        <p class="text-sm text-slate-700 font-medium leading-relaxed max-w-2xl">
          Select a topic to open the presentation notes.
        </p>
      </div>

      <!-- Decks Section -->
      <section class="space-y-6">
        {decks.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {decks.map((deck) => (
              <DeckCard {...deck} />
            ))}
          </div>
        ) : (
          <div class="p-8 rounded-xl bg-white border-2 border-slate-300 text-center max-w-lg mx-auto my-6 shadow-sm">
            <div class="w-10 h-10 rounded-full bg-slate-100 border-2 border-slate-300 text-slate-700 flex items-center justify-center mx-auto mb-3">
              <Layers class="w-5 h-5" />
            </div>
            <h3 class="text-base font-bold text-slate-950 mb-1">No presentations published yet</h3>
            <p class="text-xs text-slate-600 font-medium m-0">
              Presentations will appear here once added.
            </p>
          </div>
        )}
      </section>

      <!-- Keyboard Shortcuts Quick Guide -->
      <section class="mt-12 p-5 rounded-xl bg-white border-2 border-slate-300 shadow-sm">
        <div class="flex items-center gap-3">
          <div class="p-2.5 rounded-lg bg-indigo-50 text-indigo-900 border border-indigo-200">
            <Keyboard class="w-5 h-5" />
          </div>
          <div>
            <h4 class="text-sm font-bold text-slate-950 mb-0.5">Navigation Shortcuts</h4>
            <p class="text-xs text-slate-700 font-medium m-0">
              <kbd class="px-1.5 py-0.5 rounded bg-slate-100 border border-slate-300 text-indigo-900 font-mono text-xs font-bold">SPACE</kbd> next slide, <kbd class="px-1.5 py-0.5 rounded bg-slate-100 border border-slate-300 text-indigo-900 font-mono text-xs font-bold">S</kbd> speaker notes, <kbd class="px-1.5 py-0.5 rounded bg-slate-100 border border-slate-300 text-indigo-900 font-mono text-xs font-bold">ESC</kbd> overview grid, <kbd class="px-1.5 py-0.5 rounded bg-slate-100 border border-slate-300 text-indigo-900 font-mono text-xs font-bold">?</kbd> shortcuts guide.
            </p>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="pt-6 border-t-2 border-slate-200 text-xs text-slate-600 font-medium">
      <span>BIT</span>
    </footer>
  </div>
</BaseLayout>
