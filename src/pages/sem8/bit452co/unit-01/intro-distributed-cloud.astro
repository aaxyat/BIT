---
import DeckLayout from '../../../../layouts/DeckLayout.astro';
import Slide from '../../../../components/slides/Slide.astro';
import Card from '../../../../components/slides/Card.astro';
import KeyTerms from '../../../../components/slides/KeyTerms.astro';
import Table from '../../../../components/slides/Table.astro';
import CodeBlock from '../../../../components/slides/CodeBlock.astro';
import ThreeCanvas from '../../../../components/three/ThreeCanvas.astro';
import Mermaid from '../../../../components/slides/Mermaid.astro';
import SpeakerNotes from '../../../../components/slides/SpeakerNotes.astro';

const distributedMessagePassingCode = `// Distributed Node Message Broker Simulation
class DistributedNode {
  constructor(nodeId, networkLatencyMs = 15) {
    this.nodeId = nodeId;
    this.networkLatencyMs = networkLatencyMs;
    this.localState = new Map();
    this.peers = new Map();
  }

  registerPeer(peerNode) {
    this.peers.set(peerNode.nodeId, peerNode);
  }

  async send(targetNodeId, message) {
    const target = this.peers.get(targetNodeId);
    if (!target) throw new Error(\`Node \${targetNodeId} unreachable\`);
    
    // Simulate network latency and packet serialization
    await new Promise(resolve => setTimeout(resolve, this.networkLatencyMs));
    return target.receive(this.nodeId, message);
  }

  receive(senderNodeId, message) {
    this.localState.set(message.key, message.value);
    return {
      status: "ACK",
      receiver: this.nodeId,
      appliedState: message
    };
  }
}

// Cluster Execution
const nodeA = new DistributedNode("node-us-east-1", 10);
const nodeB = new DistributedNode("node-eu-west-1", 85);
nodeA.registerPeer(nodeB);

console.log("Transmitting state across network boundary...");
nodeA.send("node-eu-west-1", { key: "cluster_config", value: "replicated" })
  .then(res => console.log("Response:", JSON.stringify(res)));`;

const cloudCostFormulaCode = `// Total Cost of Ownership (TCO) & Break-Even Analysis
function calculateCloudBreakEven({
  onPremHardwareCost,    // Upfront CAPEX (Servers, Switches, UPS)
  datacenterOpexYearly,  // Power, Cooling, Admin, Space
  cloudMonthlyCost,      // Dynamic IaaS/PaaS billing
  operationalYears = 3
}) {
  const totalOnPremTco = onPremHardwareCost + (datacenterOpexYearly * operationalYears);
  const totalCloudTco = cloudMonthlyCost * 12 * operationalYears;
  const costDelta = totalCloudTco - totalOnPremTco;

  return {
    onPremTco: totalOnPremTco,
    cloudTco: totalCloudTco,
    favorableModel: costDelta < 0 ? "Cloud OPEX" : "On-Premises CAPEX",
    annualSavings: Math.abs(costDelta / operationalYears)
  };
}

const analysis = calculateCloudBreakEven({
  onPremHardwareCost: 120000,
  datacenterOpexYearly: 45000,
  cloudMonthlyCost: 6200,
  operationalYears: 3
});

console.log("3-Year Infrastructure TCO Analysis:", JSON.stringify(analysis, null, 2));`;
---

<DeckLayout
  title="BIT 542CO: Distributed & Cloud Computing — Unit 1: Introduction (10 Hours)"
  description="Comprehensive 10-hour lecture notes on distributed system goals, hardware/software concepts, design challenges, and cloud architectures."
>
  <!-- ========================================================================
       SLIDE 1: FORMAL TITLE SLIDE
       ======================================================================== -->
  <Slide
    id="title-slide"
    eyebrow="BIT 542CO · DISTRIBUTED & CLOUD COMPUTING"
    title="Unit 1: Introduction to Distributed Systems & Cloud Computing"
    subtitle="10-Hour Master Curriculum · Architectural Foundations, Hardware/Software Models, and Cloud Utility Paradigms"
    unit="Unit 01: Introduction"
  >
    <div class="space-y-4 max-w-4xl">
      <div class="p-4 rounded-xl bg-slate-100 border-2 border-slate-300">
        <h4 class="text-sm font-extrabold text-slate-950 uppercase tracking-wide mb-1">Curriculum Scope (10 Teaching Hours)</h4>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-xs text-slate-800 font-medium">
          <div>• Part 1: Distributed Systems Definition, Motivations & Core Goals</div>
          <div>• Part 2: Hardware Concepts: UMA, NUMA & Multicomputers</div>
          <div>• Part 3: Software Layers: Distributed OS, Network OS & Middleware</div>
          <div>• Part 4: Core Design Issues, Heterogeneity & Scalability</div>
          <div>• Part 5: NIST Cloud Architecture & SPI Service Models</div>
          <div>• Part 6: Deployment Models, Shared Governance & Challenges</div>
        </div>
      </div>
      <p class="text-sm leading-relaxed text-slate-700 font-medium">
        This unit establishes the theoretical models, physical memory topologies, middleware software abstractions, and cloud utility infrastructure that underpin modern large-scale computing.
      </p>
    </div>
    <SpeakerNotes>
      Welcome students to Unit 1 of BIT 542CO. Outline the 10-hour teaching schedule. Explain that this unit builds the vocabulary and architectural foundations required for all subsequent units in the course.
    </SpeakerNotes>
  </Slide>

  <!-- ========================================================================
       SLIDE 2: MOTIVATION & WHY DISTRIBUTED SYSTEMS MATTER
       ======================================================================== -->
  <Slide
    id="motivation"
    eyebrow="01 · DISTRIBUTED FOUNDATIONS"
    title="Why Distributed Systems? Physical & Economic Motivations"
    layout="card-grid"
    unit="Unit 01: Introduction"
  >
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 my-auto">
      <Card title="Physical Hardware Limits" badge="Moore's Law Limits" glow="indigo">
        <p class="text-xs text-slate-700 font-bold mb-1">Single-chip scaling hits the Power Wall and Memory Wall.</p>
        <p class="text-xs leading-relaxed text-slate-900 font-medium">
          Clock frequencies stalled at 4–5 GHz due to thermal dissipation limits ($P = C \cdot V^2 \cdot f$). Vertical scaling (buying a bigger server) becomes exponentially expensive, whereas horizontal scaling (adding commodity nodes) scales linearly.
        </p>
      </Card>

      <Card title="Fault Tolerance & Reliability" badge="Availability" glow="cyan">
        <p class="text-xs text-slate-700 font-bold mb-1">No single point of physical hardware failure.</p>
        <p class="text-xs leading-relaxed text-slate-900 font-medium">
          A centralized server represents a single point of failure (SPOF). Distributed clusters provide redundancy: if 3 out of 10 nodes crash or lose power, the remaining 7 continue serving client requests with zero total downtime.
        </p>
      </Card>

      <Card title="Geographical Locality" badge="Latency Physics" glow="amber">
        <p class="text-xs text-slate-700 font-bold mb-1">Speed of light in fiber enforces latency bounds.</p>
        <p class="text-xs leading-relaxed text-slate-900 font-medium">
          Signal propagation across global fiber optics introduces ~100ms round-trip latency per 10,000 km. Distributing compute instances near end users across worldwide regions reduces access latency to under 15ms.
        </p>
      </Card>
    </div>
    <SpeakerNotes>
      Explain the Power Wall: why CPUs no longer double in clock speed every 18 months, forcing software architecture to embrace distributed multicore and multi-node clusters.
    </SpeakerNotes>
  </Slide>

  <!-- ========================================================================
       SLIDE 3: FORMAL DEFINITION OF DISTRIBUTED SYSTEM
       ======================================================================== -->
  <Slide
    id="formal-definition"
    eyebrow="01 · DISTRIBUTED FOUNDATIONS"
    title="Formal Definition & Architectural Characteristics"
    layout="split-sidebar"
    unit="Unit 01: Introduction"
  >
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 h-full">
      <div class="md:col-span-2 space-y-4">
        <p class="text-base leading-relaxed text-slate-900 font-medium">
          A <strong>distributed system</strong> is a collection of autonomous computing entities that communicate over a shared network and coordinate their actions by passing messages, presenting themselves to end users as a single, coherent computing facility.
        </p>
        <div class="lecture-card border-2 border-slate-300 space-y-2">
          <h4 class="text-sm font-bold text-slate-950 uppercase">Three Essential Invariant Properties:</h4>
          <ul class="text-xs text-slate-900 space-y-1.5 pl-4 list-disc font-medium">
            <li><strong>Concurrent Execution</strong>: Multiple independent threads of execution run simultaneously on physically separated processors without shared global state.</li>
            <li><strong>No Global Physical Clock</strong>: Synchronization cannot rely on shared physical timers; time ordering must be established via logical timestamps or consensus protocols.</li>
            <li><strong>Independent Failure Modes</strong>: Components fail independently. Some servers or network links will fail while the rest of the system remains fully operational.</li>
          </ul>
        </div>
      </div>

      <div class="md:col-span-1">
        <KeyTerms
          title="Core Terms"
          terms={[
            {
              term: "Autonomous Entity",
              definition: "A compute host with private CPU and local memory running an independent OS kernel."
            },
            {
              term: "Message Passing",
              definition: "Communication via discrete network packets rather than shared memory address reads/writes."
            },
            {
              term: "Single-System Image",
              definition: "The illusion that a cluster of separate physical servers is a single unified computing device."
            }
          ]}
        />
      </div>
    </div>
    <SpeakerNotes>
      Contrast shared-memory concurrency (mutex locks, threads) with distributed concurrency (network messages, timeouts, RPCs).
    </SpeakerNotes>
  </Slide>

  <!-- ========================================================================
       SLIDE 4: THE FOUR FUNDAMENTAL GOALS
       ======================================================================== -->
  <Slide
    id="four-goals"
    eyebrow="01 · DISTRIBUTED FOUNDATIONS"
    title="The Four Fundamental Goals of Distributed Systems"
    layout="card-grid"
    unit="Unit 01: Introduction"
  >
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 my-auto">
      <Card title="1. Making Resources Accessible" badge="Goal 1" glow="indigo">
        <p class="text-xs text-slate-700 font-bold mb-1">Sharing expensive peripherals, storage volumes, and data stores.</p>
        <p class="text-xs leading-relaxed text-slate-900 font-medium">
          Provides economic advantages by pooling resources (printers, multi-terabyte databases, compute clusters) across corporate networks while strictly managing multi-user access control and data security.
        </p>
      </Card>

      <Card title="2. Distribution Transparency" badge="Goal 2" glow="cyan">
        <p class="text-xs text-slate-700 font-bold mb-1">Hiding the distributed nature of system components.</p>
        <p class="text-xs leading-relaxed text-slate-900 font-medium">
          An ideal system presents resources so that users and application programs perceive them as local, concealing physical locations, data replication, network migration, and component failures.
        </p>
      </Card>

      <Card title="3. Openness & Interoperability" badge="Goal 3" glow="amber">
        <p class="text-xs text-slate-700 font-bold mb-1">Standardized interfaces and portable service definitions.</p>
        <p class="text-xs leading-relaxed text-slate-900 font-medium">
          Specified through Interface Definition Languages (IDLs), RESTful APIs, and standard protocols, allowing components built in different programming languages by different vendors to interoperate cleanly.
        </p>
      </Card>

      <Card title="4. Scalability" badge="Goal 4" glow="rose">
        <p class="text-xs text-slate-700 font-bold mb-1">Maintaining performance across scale expansions.</p>
        <p class="text-xs leading-relaxed text-slate-900 font-medium">
          System performance scales gracefully along three independent axes: size scalability (adding users/resources), geographical scalability (spanning continents), and administrative scalability (crossing organizations).
        </p>
      </Card>
    </div>
    <SpeakerNotes>
      Walk through the 4 goals. Emphasize that achieving 100% transparency often conflicts with performance over high-latency networks.
    </SpeakerNotes>
  </Slide>

  <!-- ========================================================================
       SLIDE 5: DISTRIBUTION TRANSPARENCY DEEP DIVE (PART 1)
       ======================================================================== -->
  <Slide
    id="transparency-spatial"
    eyebrow="01 · DISTRIBUTION TRANSPARENCY"
    title="Distribution Transparency: Access, Location & Migration"
    layout="split-sidebar"
    unit="Unit 01: Introduction"
  >
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 h-full">
      <div class="md:col-span-2 space-y-4">
        <div class="lecture-card border-2 border-slate-300 space-y-3">
          <div>
            <h4 class="text-sm font-bold text-indigo-900 uppercase mb-1">1. Access Transparency</h4>
            <p class="text-xs text-slate-900 m-0 leading-relaxed font-medium">
              Hides differences in data representation and the way resources are accessed on different machines. For example, a client program accesses a file on a big-endian Solaris server or a little-endian Linux x86 node using identical read/write function calls.
            </p>
          </div>

          <div>
            <h4 class="text-sm font-bold text-indigo-900 uppercase mb-1">2. Location Transparency</h4>
            <p class="text-xs text-slate-900 m-0 leading-relaxed font-medium">
              Hides where in physical space a resource is located. The user identifies resources purely by logical names (e.g. <code>http://api.bank.com/accounts/402</code>) without knowing the physical server rack, IP address, or datacenter building.
            </p>
          </div>

          <div>
            <h4 class="text-sm font-bold text-indigo-900 uppercase mb-1">3. Migration Transparency</h4>
            <p class="text-xs text-slate-900 m-0 leading-relaxed font-medium">
              Hides that a resource can move to another physical location while it is idle without affecting client access. For example, relocating an idle database partition from Server A to Server B during storage rebalancing.
            </p>
          </div>
        </div>
      </div>

      <div class="md:col-span-1">
        <KeyTerms
          title="Spatial Terms"
          terms={[
            {
              term: "Access Transparency",
              definition: "Hiding data format and protocol differences between heterogeneous client/server architectures."
            },
            {
              term: "Location Transparency",
              definition: "Decoupling logical resource names from physical network coordinates."
            },
            {
              term: "Migration Transparency",
              definition: "Moving offline resources between servers without breaking logical name bindings."
            }
          ]}
        />
      </div>
    </div>
    <SpeakerNotes>
      Explain how DNS and URLs achieve location transparency. Point out that IP addresses break location transparency if hardcoded into application source code.
    </SpeakerNotes>
  </Slide>

  <!-- ========================================================================
       SLIDE 6: DISTRIBUTION TRANSPARENCY DEEP DIVE (PART 2)
       ======================================================================== -->
  <Slide
    id="transparency-runtime"
    eyebrow="01 · DISTRIBUTION TRANSPARENCY"
    title="Distribution Transparency: Relocation, Replication, Concurrency & Failure"
    layout="table"
    unit="Unit 01: Introduction"
  >
    <div class="my-auto">
      <Table
        headers={["Transparency Type", "What Is Hidden from the Client Application", "Real-World Industrial Example"]}
        rows={[
          ["Relocation", "Resource moving dynamically while receiving active requests", "Live VM migration across hypervisors without dropping TCP connections"],
          ["Replication", "That multiple identical copies exist across distinct servers", "Amazon S3 storing 3 geographically separated copies of an object"],
          ["Concurrency", "That multiple clients are simultaneously accessing shared data", "Database row locking / MVCC preventing dirty read race conditions"],
          ["Failure", "That a server or network switch has crashed and restarted", "Web load balancer redirecting HTTP requests to healthy replica"],
          ["Persistence", "Whether a resource is currently in RAM or swapped to SSD", "Object-relational mapping (ORM) hydrating entities on demand"]
        ]}
      />

      <div class="lecture-card border-2 border-amber-300 bg-amber-50 mt-3 p-3">
        <h4 class="text-xs font-bold text-amber-950 uppercase mb-1">Engineering Trade-off: Degree of Transparency</h4>
        <p class="text-xs text-amber-950 m-0 font-medium">
          Total transparency is not always desirable. Attempting to mask signal latency to a server on Mars or guaranteeing instantaneous replication across continents causes massive transaction blocking.
        </p>
      </div>
    </div>
    <SpeakerNotes>
      Walk through why 100% failure transparency is physically impossible across WAN: network timeouts vs server death cannot be distinguished with certainty.
    </SpeakerNotes>
  </Slide>

  <!-- ========================================================================
       SLIDE 7: HARDWARE CONCEPTS - FLYNN'S TAXONOMY & COUPLING
       ======================================================================== -->
  <Slide
    id="hardware-flynn"
    eyebrow="02 · HARDWARE CONCEPTS"
    title="Hardware Architectures: Flynn's Taxonomy & System Coupling"
    layout="split-sidebar"
    unit="Unit 01: Introduction"
  >
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 h-full">
      <div class="md:col-span-2 space-y-4">
        <p class="text-base leading-relaxed text-slate-900 font-medium">
          Under Michael J. Flynn's classification, computer architectures are categorized by the number of concurrent instruction streams and data streams. All distributed systems fall under <strong>MIMD (Multiple Instruction, Multiple Data)</strong>: multiple processors executing independent instruction streams on independent datasets.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="lecture-card border-2 border-slate-300">
            <h4 class="text-sm font-bold text-indigo-900 mb-1">Tightly Coupled Systems</h4>
            <p class="text-xs text-slate-900 m-0 leading-relaxed font-medium">
              Processors share physical clock timing, a common high-speed bus, and a single shared memory address space. Inter-processor communication delay is in nanoseconds.
            </p>
          </div>
          <div class="lecture-card border-2 border-slate-300">
            <h4 class="text-sm font-bold text-indigo-900 mb-1">Loosely Coupled Systems</h4>
            <p class="text-xs text-slate-900 m-0 leading-relaxed font-medium">
              Processors have private memory and separate operating systems. Communication occurs exclusively over network links. Inter-node communication delay is in milliseconds.
            </p>
          </div>
        </div>
      </div>

      <div class="md:col-span-1">
        <KeyTerms
          title="Flynn Terms"
          terms={[
            {
              term: "MIMD Classification",
              definition: "Multiple Instruction, Multiple Data: autonomous processors executing distinct programs on separate data."
            },
            {
              term: "Coupling Degree",
              definition: "Measure of spatial proximity, shared clock dependency, and memory sharing between processors."
            },
            {
              term: "Latency Ratio",
              definition: "Shared bus access (~10ns) vs local network (~100µs) vs WAN internet (~50ms) introduces 100,000x gap."
            }
          ]}
        />
      </div>
    </div>
    <SpeakerNotes>
      Explain Flynn's 4 classes: SISD (traditional uniprocessor), SIMD (GPU vector units), MISD (fault-tolerant flight controllers), MIMD (distributed systems).
    </SpeakerNotes>
  </Slide>

  <!-- ========================================================================
       SLIDE 8: SHARED MEMORY MULTIPROCESSORS (UMA VS NUMA)
       ======================================================================== -->
  <Slide
    id="hardware-multiprocessors"
    eyebrow="02 · HARDWARE CONCEPTS"
    title="Shared-Memory Multiprocessors: UMA vs. NUMA Architectures"
    layout="split-sidebar"
    unit="Unit 01: Introduction"
  >
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 h-full">
      <div class="md:col-span-2 space-y-4">
        <p class="text-base leading-relaxed text-slate-900 font-medium">
          In a multiprocessor, all CPUs execute within a single uniform physical memory address space. Every CPU can read or write any memory address using standard hardware load/store instructions.
        </p>

        <div class="lecture-card border-2 border-slate-300">
          <h4 class="text-sm font-bold text-slate-950 mb-1 uppercase">1. Uniform Memory Access (UMA) — Symmetric Multiprocessors (SMP)</h4>
          <p class="text-xs text-slate-900 m-0 leading-relaxed font-medium">
            All CPUs share a single memory controller and system bus. Every CPU experiences identical read/write access latency to all memory locations. <em>Bottleneck:</em> As CPU count increases beyond 16–32 cores, memory bus contention severely degrades performance.
          </p>
        </div>

        <div class="lecture-card border-2 border-slate-300">
          <h4 class="text-sm font-bold text-slate-950 mb-1 uppercase">2. Non-Uniform Memory Access (NUMA)</h4>
          <p class="text-xs text-slate-900 m-0 leading-relaxed font-medium">
            Memory is physically divided into local banks per CPU socket, connected via high-speed interconnects (e.g. Intel UPI / AMD Infinity Fabric). Accessing local memory is 3–5x faster than accessing remote memory attached to another CPU socket.
          </p>
        </div>
      </div>

      <div class="md:col-span-1">
        <KeyTerms
          title="Memory Terms"
          terms={[
            {
              term: "UMA (SMP)",
              definition: "Uniform Memory Access: identical memory latency for all processors across a shared system bus."
            },
            {
              term: "NUMA",
              definition: "Non-Uniform Memory Access: physical memory is partitioned per socket; local access is faster than remote."
            },
            {
              term: "Cache Coherence",
              definition: "Hardware protocol (MESI/MOESI) ensuring all CPU cache lines reflect the latest memory writes."
            }
          ]}
        />
      </div>
    </div>
    <SpeakerNotes>
      Explain the cache coherence tax: why building 1,000-core shared-memory machines is economically non-viable due to directory-based cache invalidation overhead.
    </SpeakerNotes>
  </Slide>

  <!-- ========================================================================
       SLIDE 9: DISTRIBUTED-MEMORY MULTICOMPUTERS
       ======================================================================== -->
  <Slide
    id="hardware-multicomputers"
    eyebrow="02 · HARDWARE CONCEPTS"
    title="Distributed-Memory Multicomputers: Clusters & Interconnects"
    layout="split-sidebar"
    unit="Unit 01: Introduction"
  >
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 h-full">
      <div class="md:col-span-2 space-y-4">
        <p class="text-base leading-relaxed text-slate-900 font-medium">
          A <strong>multicomputer</strong> consists of multiple autonomous computing nodes, each with its own private CPU, cache, memory controller, and local storage. Processors have no physical shared memory address space; a CPU cannot directly execute a load/store instruction against another node's RAM.
        </p>

        <div class="lecture-card border-2 border-slate-300 space-y-2">
          <h4 class="text-sm font-bold text-slate-950 uppercase">Interconnect Topologies & Communication:</h4>
          <ul class="text-xs text-slate-900 space-y-1.5 pl-4 list-disc font-medium">
            <li><strong>Communication Mechanism</strong>: Explicit message passing via Network Interface Cards (NICs) over packet-switched networks.</li>
            <li><strong>Cluster Topologies</strong>: Nodes organized in rack-mounted server chassis connected via Top-of-Rack (ToR) switches, Spine-Leaf datacenter networks, or torus/hypercube topologies for supercomputing.</li>
            <li><strong>High-Speed Fabrics</strong>: Commodity Ethernet (10/25/100 Gbps) or specialized ultra-low-latency InfiniBand / RDMA (Remote Direct Memory Access) fabrics.</li>
          </ul>
        </div>
      </div>

      <div class="md:col-span-1">
        <KeyTerms
          title="Cluster Terms"
          terms={[
            {
              term: "Multicomputer",
              definition: "Loosely-coupled system of independent computers communicating exclusively over network interconnects."
            },
            {
              term: "Spine-Leaf Fabric",
              definition: "Datacenter network topology ensuring constant 2-hop switching latency between any two cluster server racks."
            },
            {
              term: "RDMA",
              definition: "Remote Direct Memory Access: bypassing the operating system kernel to copy data directly between node memories."
            }
          ]}
        />
      </div>
    </div>
    <SpeakerNotes>
      Show why multicomputers won: commodity PC hardware connected by Ethernet scales to millions of cores at 1/10th the cost of proprietary supercomputers.
    </SpeakerNotes>
  </Slide>

  <!-- ========================================================================
       SLIDE 10: 3D DEMONSTRATION - HARDWARE TOPOLOGIES
       ======================================================================== -->
  <Slide
    id="demo-hardware-topologies"
    eyebrow="02 · VISUAL DEMONSTRATION"
    title="Visual Model: Shared Bus Contention vs. Switched Node Clusters"
    layout="split-sidebar"
    unit="Unit 01: Introduction"
  >
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center my-auto">
      <div class="space-y-4">
        <p class="text-base leading-relaxed text-slate-900 font-medium">
          The 3D model demonstrates the geometric contrast between a centralized shared-memory bus (central core bottleneck) and an interconnected distributed cluster topology (radial mesh nodes).
        </p>
        <div class="lecture-card border-2 border-slate-300">
          <h4 class="text-xs font-bold text-indigo-950 uppercase tracking-wide mb-1">Spatial Comparison</h4>
          <p class="text-xs text-slate-900 m-0 leading-relaxed font-medium">
            <strong>Drag the 3D model</strong> to rotate and inspect node distribution. Notice how distributed nodes eliminate central bus serialization by delegating communication across independent mesh links.
          </p>
        </div>
        <p class="text-xs text-slate-600 font-bold m-0">
          *Scalability Theorem: A shared bus scales as O(1) in bandwidth capacity, whereas switched network multicomputers scale as O(N).
        </p>
      </div>

      <div class="flex justify-center items-center">
        <ThreeCanvas model="torus" color="#4338ca" height="320px" />
      </div>
    </div>
    <SpeakerNotes>
      Interact with the 3D model. Explain how the torus geometry maps to 2D/3D torus interconnects used in supercomputing clusters like IBM Blue Gene.
    </SpeakerNotes>
  </Slide>

  <!-- ========================================================================
       SLIDE 11: SOFTWARE CONCEPTS - THREE OPERATING SYSTEM MODELS
       ======================================================================== -->
  <Slide
    id="software-models-overview"
    eyebrow="03 · SOFTWARE CONCEPTS"
    title="Software Concepts: Distributed OS vs. Network OS vs. Middleware"
    layout="card-grid"
    unit="Unit 01: Introduction"
  >
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 my-auto">
      <Card title="1. Distributed OS (DOS)" badge="Tightly Coupled" glow="indigo">
        <p class="text-xs text-slate-700 font-bold mb-1">Single homogeneous kernel managing multiple CPU nodes.</p>
        <p class="text-xs leading-relaxed text-slate-900 font-medium">
          Presents full transparency. The kernel manages process migration, distributed memory paging, and hardware allocation. <em>Limitation:</em> Fails in real enterprises because all machines must run the exact same operating system. Examples: Amoeba, Sprite, Mach.
        </p>
      </Card>

      <Card title="2. Network OS (NOS)" badge="Loosely Coupled" glow="cyan">
        <p class="text-xs text-slate-700 font-bold mb-1">Independent heterogeneous kernels with networking tools.</p>
        <p class="text-xs leading-relaxed text-slate-900 font-medium">
          Provides zero distribution transparency. Users explicitly log in to remote machines (SSH) or mount remote disks (NFS, SMB). Each node retains absolute autonomous control over local resources. Examples: UNIX, Linux, Windows Server.
        </p>
      </Card>

      <Card title="3. Middleware Systems" badge="Modern Standard" glow="amber">
        <p class="text-xs text-slate-700 font-bold mb-1">Software layer positioned between OS and applications.</p>
        <p class="text-xs leading-relaxed text-slate-900 font-medium">
          Runs on top of heterogeneous Network Operating Systems to provide uniform high-level services: RPC, distributed transactions, naming directories, and security tokens. Examples: gRPC, CORBA, Java RMI, Apache Kafka.
        </p>
      </Card>
    </div>
    <SpeakerNotes>
      Emphasize that modern computing runs on NOS kernels with Middleware layered on top. Distributed Operating Systems are primarily of historical/academic interest.
    </SpeakerNotes>
  </Slide>

