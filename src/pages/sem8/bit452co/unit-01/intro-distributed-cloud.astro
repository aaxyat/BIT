---
import DeckLayout from '../../../../layouts/DeckLayout.astro';
import Slide from '../../../../components/slides/Slide.astro';
import Card from '../../../../components/slides/Card.astro';
import KeyTerms from '../../../../components/slides/KeyTerms.astro';
import Table from '../../../../components/slides/Table.astro';
import CodeBlock from '../../../../components/slides/CodeBlock.astro';
import ThreeCanvas from '../../../../components/three/ThreeCanvas.astro';
import Mermaid from '../../../../components/slides/Mermaid.astro';
import SpeakerNotes from '../../../../components/slides/SpeakerNotes.astro';

const distributedMessagePassingCode = `// Distributed Node Message Passing Example
class DistributedNode {
  constructor(nodeId, networkLatencyMs = 15) {
    this.nodeId = nodeId;
    this.networkLatencyMs = networkLatencyMs;
    this.localState = new Map();
    this.peers = new Map();
  }

  registerPeer(peerNode) {
    this.peers.set(peerNode.nodeId, peerNode);
  }

  async send(targetNodeId, message) {
    const target = this.peers.get(targetNodeId);
    if (!target) throw new Error(\`Node \${targetNodeId} unreachable\`);
    
    // Simulate network latency
    await new Promise(resolve => setTimeout(resolve, this.networkLatencyMs));
    return target.receive(this.nodeId, message);
  }

  receive(senderNodeId, message) {
    this.localState.set(message.key, message.value);
    return {
      status: "ACK",
      receiver: this.nodeId,
      appliedState: message
    };
  }
}

// Connect two nodes and send data
const nodeA = new DistributedNode("node-us-east-1", 10);
const nodeB = new DistributedNode("node-eu-west-1", 85);
nodeA.registerPeer(nodeB);

console.log("Sending data across network...");
nodeA.send("node-eu-west-1", { key: "cluster_config", value: "replicated" })
  .then(res => console.log("Response:", JSON.stringify(res)));`;

const cloudCostFormulaCode = `// Comparing On-Premises Cost vs Cloud Cost
function compareCosts({
  onPremHardwareCost,    // Upfront cost to buy servers
  datacenterOpexYearly,  // Electricity, cooling, building rent
  cloudMonthlyCost,      // Monthly cloud bill
  years = 3
}) {
  const onPremTotal = onPremHardwareCost + (datacenterOpexYearly * years);
  const cloudTotal = cloudMonthlyCost * 12 * years;
  const difference = cloudTotal - onPremTotal;

  return {
    onPremisesTotal: onPremTotal,
    cloudTotal: cloudTotal,
    cheaperOption: difference < 0 ? "Cloud" : "On-Premises",
    yearlyDifference: Math.abs(difference / years)
  };
}

const result = compareCosts({
  onPremHardwareCost: 120000,
  datacenterOpexYearly: 45000,
  cloudMonthlyCost: 6200,
  years: 3
});

console.log("3-Year Cost Comparison:", JSON.stringify(result, null, 2));`;
---

<DeckLayout
  title="Distributed & Cloud Computing: Introduction"
  description="Introduction to distributed systems, hardware memory models, software layers, and cloud computing architectures."
>
  <!-- ========================================================================
       SLIDE 1: TITLE SLIDE
       ======================================================================== -->
  <Slide
    id="title-slide"
    eyebrow="DISTRIBUTED & CLOUD COMPUTING"
    title="Introduction to Distributed Systems & Cloud Computing"
    subtitle="Core Concepts, Hardware Models, and Cloud Architectures"
    unit="BIT 542CO: Distributed & Cloud Computing"
  >
    <div class="space-y-4 max-w-4xl">
      <div class="p-4 rounded-xl bg-slate-100 border-2 border-slate-300">
        <h4 class="text-sm font-extrabold text-slate-950 uppercase tracking-wide mb-1">Topics in this Unit</h4>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-xs text-slate-800 font-medium">
          <div>• What are distributed systems and why do we build them?</div>
          <div>• Hardware models: shared memory vs separate computers</div>
          <div>• Software layers: operating systems and middleware</div>
          <div>• Common design challenges: handling errors and scaling up</div>
          <div>• Cloud computing basics and service models (IaaS, PaaS, SaaS)</div>
          <div>• Cloud deployment types and cost comparisons</div>
        </div>
      </div>
      <p class="text-sm leading-relaxed text-slate-700 font-medium">
        This unit explains how multiple computers connect together over networks to share work, and how cloud providers package these systems into services you can use on demand.
      </p>
    </div>
    <SpeakerNotes>
      Welcome everyone to the first unit of Distributed and Cloud Computing. Explain that cloud computing is built on top of distributed systems ideas developed over the last several decades.
    </SpeakerNotes>
  </Slide>

  <!-- ========================================================================
       SLIDE 2: MOTIVATION
       ======================================================================== -->
  <Slide
    id="motivation"
    eyebrow="DISTRIBUTED FOUNDATIONS"
    title="Why Do We Connect Multiple Computers Together?"
    layout="card-grid"
    unit="BIT 542CO: Distributed & Cloud Computing"
  >
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 my-auto">
      <Card title="Limits of One Machine" badge="Physical Limits" glow="indigo">
        <p class="text-xs text-slate-700 font-bold mb-1">One computer can only get so big and fast.</p>
        <p class="text-xs leading-relaxed text-slate-900 font-medium">
          Making a single computer faster hits heat and power limits. Buying one giant super-computer is very expensive. Buying many standard computers and linking them together gives more power for less money.
        </p>
      </Card>

      <Card title="Keeping Systems Running" badge="Reliability" glow="cyan">
        <p class="text-xs text-slate-700 font-bold mb-1">If one machine breaks, others keep working.</p>
        <p class="text-xs leading-relaxed text-slate-900 font-medium">
          If an entire website runs on a single server and that server crashes, the site goes down. When work is spread across ten servers, three can fail and the website stays online without interruption.
        </p>
      </Card>

      <Card title="Reaching Users Worldwide" badge="Speed" glow="amber">
        <p class="text-xs text-slate-700 font-bold mb-1">Signals take time to travel long distances.</p>
        <p class="text-xs leading-relaxed text-slate-900 font-medium">
          Data traveling through undersea cables takes time. Placing servers in different countries close to users makes websites load in milliseconds instead of seconds.
        </p>
      </Card>
    </div>
    <SpeakerNotes>
      Give everyday examples like Netflix or Google: a single computer could never store all the videos or handle millions of searches at the same second.
    </SpeakerNotes>
  </Slide>

  <!-- ========================================================================
       SLIDE 3: DEFINITION
       ======================================================================== -->
  <Slide
    id="definition"
    eyebrow="DISTRIBUTED FOUNDATIONS"
    title="What Is a Distributed System?"
    layout="split-sidebar"
    unit="BIT 542CO: Distributed & Cloud Computing"
  >
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 h-full">
      <div class="md:col-span-2 space-y-4">
        <p class="text-base leading-relaxed text-slate-900 font-medium">
          A <strong>distributed system</strong> is a group of independent computers that talk to each other over a network by sending messages, while appearing to users as if they were just one single computer.
        </p>
        <div class="lecture-card border-2 border-slate-300 space-y-2">
          <h4 class="text-sm font-bold text-slate-950 uppercase">Three Core Rules of Distributed Systems:</h4>
          <ul class="text-xs text-slate-900 space-y-1.5 pl-4 list-disc font-medium">
            <li><strong>Running at the same time</strong>: Many computers run their own tasks at the same exact moment.</li>
            <li><strong>No shared master clock</strong>: Each computer has its own timer. They must agree on order of events using network messages.</li>
            <li><strong>Separate failures</strong>: One computer can crash or lose its internet cable without stopping the other computers.</li>
          </ul>
        </div>
      </div>

      <div class="md:col-span-1">
        <KeyTerms
          title="Key Terms"
          terms={[
            {
              term: "Node",
              definition: "A single computer in a network with its own processor, memory, and operating system."
            },
            {
              term: "Message",
              definition: "A packet of data sent over the network from one computer to another."
            },
            {
              term: "Single System",
              definition: "Making many separate computers look like one simple service to the user."
            }
          ]}
        />
      </div>
    </div>
    <SpeakerNotes>
      Emphasize that the user does not need to know which specific computer answered their request.
    </SpeakerNotes>
  </Slide>

  <!-- ========================================================================
       SLIDE 4: THE FOUR GOALS
       ======================================================================== -->
  <Slide
    id="four-goals"
    eyebrow="DISTRIBUTED FOUNDATIONS"
    title="The Four Main Goals of Building Distributed Systems"
    layout="card-grid"
    unit="BIT 542CO: Distributed & Cloud Computing"
  >
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 my-auto">
      <Card title="1. Sharing Resources" badge="Sharing" glow="indigo">
        <p class="text-xs text-slate-700 font-bold mb-1">Letting users share hardware and files easily.</p>
        <p class="text-xs leading-relaxed text-slate-900 font-medium">
          Allowing many people in an office or across the world to share files, printers, databases, and computing power safely without stepping on each other.
        </p>
      </Card>

      <Card title="2. Hiding the Complexity" badge="Transparency" glow="cyan">
        <p class="text-xs text-slate-700 font-bold mb-1">Making remote systems feel like local ones.</p>
        <p class="text-xs leading-relaxed text-slate-900 font-medium">
          Hiding where files are stored, how many copies exist, or whether a server restarted so users can focus on their work.
        </p>
      </Card>

      <Card title="3. Staying Open & Compatible" badge="Openness" glow="amber">
        <p class="text-xs text-slate-700 font-bold mb-1">Using clear rules so different systems work together.</p>
        <p class="text-xs leading-relaxed text-slate-900 font-medium">
          Writing clear API rules so a phone app written in Swift, a backend in Java, and a server running Linux can exchange data without issues.
        </p>
      </Card>

      <Card title="4. Easy to Scale" badge="Scalability" glow="rose">
        <p class="text-xs text-slate-700 font-bold mb-1">Growing smoothly when more users arrive.</p>
        <p class="text-xs leading-relaxed text-slate-900 font-medium">
          Handling ten users today and ten million users next month by adding more standard computers, without rewriting the whole system.
        </p>
      </Card>
    </div>
    <SpeakerNotes>
      Review each goal with simple real-world examples: sharing a Google Drive file, using standard HTTP, and handling spikes in user traffic.
    </SpeakerNotes>
  </Slide>

  <!-- ========================================================================
       SLIDE 5: TRANSPARENCY TYPES (PART 1)
       ======================================================================== -->
  <Slide
    id="transparency-part1"
    eyebrow="DISTRIBUTION TRANSPARENCY"
    title="Hiding System Details: Access, Location & Migration"
    layout="split-sidebar"
    unit="BIT 542CO: Distributed & Cloud Computing"
  >
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 h-full">
      <div class="md:col-span-2 space-y-4">
        <div class="lecture-card border-2 border-slate-300 space-y-3">
          <div>
            <h4 class="text-sm font-bold text-indigo-900 uppercase mb-1">1. Access Transparency</h4>
            <p class="text-xs text-slate-900 m-0 leading-relaxed font-medium">
              You read or write data using the same commands, whether the file is on your laptop or on a server in another country running a different operating system.
            </p>
          </div>

          <div>
            <h4 class="text-sm font-bold text-indigo-900 uppercase mb-1">2. Location Transparency</h4>
            <p class="text-xs text-slate-900 m-0 leading-relaxed font-medium">
              You find resources by name (like typing <code>google.com</code>) without needing to know which physical building, room, or IP address hosts the data.
            </p>
          </div>

          <div>
            <h4 class="text-sm font-bold text-indigo-900 uppercase mb-1">3. Migration Transparency</h4>
            <p class="text-xs text-slate-900 m-0 leading-relaxed font-medium">
              An engineer can move a database from Server A to Server B while it is idle, and your apps keep working without updating their settings.
            </p>
          </div>
        </div>
      </div>

      <div class="md:col-span-1">
        <KeyTerms
          title="Terms"
          terms={[
            {
              term: "Access Transparency",
              definition: "Hiding differences in how different computers format numbers and files."
            },
            {
              term: "Location Transparency",
              definition: "Using simple names instead of physical server coordinates."
            },
            {
              term: "Migration",
              definition: "Moving files or databases between machines without breaking links."
            }
          ]}
        />
      </div>
    </div>
    <SpeakerNotes>
      Remind students that URLs are the best example of location transparency: you type a domain name and never worry about which server rack answers.
    </SpeakerNotes>
  </Slide>

  <!-- ========================================================================
       SLIDE 6: TRANSPARENCY TYPES (PART 2)
       ======================================================================== -->
  <Slide
    id="transparency-part2"
    eyebrow="DISTRIBUTION TRANSPARENCY"
    title="Hiding System Details: Copies, Concurrent Access & Errors"
    layout="table"
    unit="BIT 542CO: Distributed & Cloud Computing"
  >
    <div class="my-auto">
      <Table
        headers={["Transparency Type", "What Is Hidden from the User", "Simple Example"]}
        rows={[
          ["Relocation", "Moving a service while it is actively in use", "Moving a virtual server to a new machine without dropping active calls"],
          ["Replication", "That multiple duplicate copies of data exist", "Saving a photo on cloud storage and it automatically saves across 3 cities"],
          ["Concurrency", "That other people are using the same data at the exact same moment", "Two people buying seats on an airline app without booking the same seat"],
          ["Failure", "That a machine crashed or restarted behind the scenes", "A web page automatically reloads from a backup server when one server loses power"]
        ]}
      />

      <div class="lecture-card border-2 border-amber-300 bg-amber-50 mt-3 p-3">
        <h4 class="text-xs font-bold text-amber-950 uppercase mb-1">Important Reality: We Cannot Hide Everything</h4>
        <p class="text-xs text-amber-950 m-0 font-medium">
          Trying to hide every single network delay across the globe would make programs freeze while waiting for confirmation. Good engineers choose when to hide details and when to show realistic loading states.
        </p>
      </div>
    </div>
    <SpeakerNotes>
      Explain why total transparency is impossible: sending data across the Pacific ocean takes at least 100 milliseconds due to the speed of light.
    </SpeakerNotes>
  </Slide>

  <!-- ========================================================================
       SLIDE 7: HARDWARE CONCEPTS - TWO BASIC DESIGNS
       ======================================================================== -->
  <Slide
    id="hardware-overview"
    eyebrow="HARDWARE CONCEPTS"
    title="Hardware Models: Shared Memory vs. Networked Machines"
    layout="split-sidebar"
    unit="BIT 542CO: Distributed & Cloud Computing"
  >
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 h-full">
      <div class="md:col-span-2 space-y-4">
        <p class="text-base leading-relaxed text-slate-900 font-medium">
          When we build systems with multiple processors, there are two main ways to connect them: sharing one common memory pool, or giving each computer its own private memory.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="lecture-card border-2 border-slate-300">
            <h4 class="text-sm font-bold text-indigo-900 mb-1">Shared Memory (Multiprocessors)</h4>
            <p class="text-xs text-slate-900 m-0 leading-relaxed font-medium">
              All processors share the same physical RAM. Any processor can read any memory location directly over a shared motherboard bus. Very fast, but limited in size.
            </p>
          </div>
          <div class="lecture-card border-2 border-slate-300">
            <h4 class="text-sm font-bold text-indigo-900 mb-1">Separate Memory (Multicomputers)</h4>
            <p class="text-xs text-slate-900 m-0 leading-relaxed font-medium">
              Every machine has its own private RAM. To share data, they must send messages over network cables. Can scale to thousands of machines.
            </p>
          </div>
        </div>
      </div>

      <div class="md:col-span-1">
        <KeyTerms
          title="Hardware Terms"
          terms={[
            {
              term: "Multiprocessor",
              definition: "Multiple CPUs sharing one common physical RAM address space."
            },
            {
              term: "Multicomputer",
              definition: "Separate computers connected by network cables, each with private RAM."
            },
            {
              term: "System Bus",
              definition: "The physical wires on a motherboard connecting CPUs to RAM."
            }
          ]}
        />
      </div>
    </div>
    <SpeakerNotes>
      Compare a shared-memory computer to people sitting around one shared whiteboard, vs multicomputers as people in separate offices sending text messages.
    </SpeakerNotes>
  </Slide>

  <!-- ========================================================================
       SLIDE 8: SHARED MEMORY (UMA VS NUMA)
       ======================================================================== -->
  <Slide
    id="hardware-uma-numa"
    eyebrow="HARDWARE CONCEPTS"
    title="Shared-Memory Computers: UMA and NUMA"
    layout="split-sidebar"
    unit="BIT 542CO: Distributed & Cloud Computing"
  >
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 h-full">
      <div class="md:col-span-2 space-y-4">
        <p class="text-base leading-relaxed text-slate-900 font-medium">
          In shared-memory computers, how CPUs connect to RAM affects performance as you add more processor cores.
        </p>

        <div class="lecture-card border-2 border-slate-300">
          <h4 class="text-sm font-bold text-slate-950 mb-1 uppercase">1. Uniform Memory Access (UMA)</h4>
          <p class="text-xs text-slate-900 m-0 leading-relaxed font-medium">
            All CPUs share one central memory bus. Every CPU takes the exact same amount of time to read any memory byte. <em>Problem:</em> If 32 CPUs try to read RAM at the same time, the bus gets clogged.
          </p>
        </div>

        <div class="lecture-card border-2 border-slate-300">
          <h4 class="text-sm font-bold text-slate-950 mb-1 uppercase">2. Non-Uniform Memory Access (NUMA)</h4>
          <p class="text-xs text-slate-900 m-0 leading-relaxed font-medium">
            Each CPU gets its own local memory bank attached directly to its socket. Reading local RAM is fast. Reading RAM attached to another CPU takes longer over internal link cables.
          </p>
        </div>
      </div>

      <div class="md:col-span-1">
        <KeyTerms
          title="Memory Types"
          terms={[
            {
              term: "UMA",
              definition: "Uniform access: all memory locations take the exact same time to read."
            },
            {
              term: "NUMA",
              definition: "Non-uniform access: local memory is fast, remote memory attached to other CPUs is slower."
            },
            {
              term: "Bus Bottleneck",
              definition: "When too many processors try to use one shared wire at the same moment."
            }
          ]}
        />
      </div>
    </div>
    <SpeakerNotes>
      Explain why personal laptops use UMA, while big 64-core database servers use NUMA to prevent memory traffic jams.
    </SpeakerNotes>
  </Slide>

  <!-- ========================================================================
       SLIDE 9: MULTICOMPUTERS & CLUSTERS
       ======================================================================== -->
  <Slide
    id="hardware-clusters"
    eyebrow="HARDWARE CONCEPTS"
    title="Networked Clusters (Multicomputers)"
    layout="split-sidebar"
    unit="BIT 542CO: Distributed & Cloud Computing"
  >
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 h-full">
      <div class="md:col-span-2 space-y-4">
        <p class="text-base leading-relaxed text-slate-900 font-medium">
          A <strong>multicomputer cluster</strong> is built by stacking standard, independent computers into server racks and connecting them with high-speed network switches.
        </p>

        <div class="lecture-card border-2 border-slate-300 space-y-2">
          <h4 class="text-sm font-bold text-slate-950 uppercase">How Cluster Machines Communicate:</h4>
          <ul class="text-xs text-slate-900 space-y-1.5 pl-4 list-disc font-medium">
            <li><strong>Message Passing</strong>: Processors send packets of bytes through network cards (NICs).</li>
            <li><strong>Rack Switches</strong>: Servers in a rack plug into a top-of-rack switch, which connects to main datacenter spine switches.</li>
            <li><strong>Affordable Scale</strong>: You can connect 100,000 standard machines together, which is impossible with shared-memory motherboards.</li>
          </ul>
        </div>
      </div>

      <div class="md:col-span-1">
        <KeyTerms
          title="Cluster Terms"
          terms={[
            {
              term: "Cluster",
              definition: "A collection of interconnected standard computers working together on common jobs."
            },
            {
              term: "Server Rack",
              definition: "A physical metal frame holding stacked server computers and network switches."
            },
            {
              term: "Network Card",
              definition: "Hardware component that converts memory data into network cable signals."
            }
          ]}
        />
      </div>
    </div>
    <SpeakerNotes>
      Show how all modern cloud datacenters (Amazon, Microsoft, Google) are built entirely out of cluster racks rather than giant single motherboards.
    </SpeakerNotes>
  </Slide>

  <!-- ========================================================================
       SLIDE 10: 3D DEMONSTRATION - HARDWARE TOPOLOGY
       ======================================================================== -->
  <Slide
    id="demo-hardware"
    eyebrow="VISUAL DEMONSTRATION"
    title="Visualizing Computer Connections: Shared Bus vs. Cluster Mesh"
    layout="split-sidebar"
    unit="BIT 542CO: Distributed & Cloud Computing"
  >
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center my-auto">
      <div class="space-y-4">
        <p class="text-base leading-relaxed text-slate-900 font-medium">
          This 3D model shows how interconnected cluster nodes form a distributed network mesh, rather than relying on one central bus wire.
        </p>
        <div class="lecture-card border-2 border-slate-300">
          <h4 class="text-xs font-bold text-indigo-950 uppercase tracking-wide mb-1">Interact with the Model</h4>
          <p class="text-xs text-slate-900 m-0 leading-relaxed font-medium">
            <strong>Click and drag</strong> the 3D shape to see how nodes connect along multiple routes. If one link fails, traffic reroutes along another connection.
          </p>
        </div>
        <p class="text-xs text-slate-600 font-bold m-0">
          *Key Takeaway: Mesh connections eliminate single points of failure in hardware design.
        </p>
      </div>

      <div class="flex justify-center items-center">
        <ThreeCanvas model="torus" color="#4338ca" height="320px" />
      </div>
    </div>
    <SpeakerNotes>
      Rotate the 3D model to show students how redundancy works when nodes form geometric meshes.
    </SpeakerNotes>
  </Slide>

  <!-- ========================================================================
       SLIDE 11: SOFTWARE CONCEPTS - THREE APPROACHES
       ======================================================================== -->
  <Slide
    id="software-approaches"
    eyebrow="SOFTWARE CONCEPTS"
    title="Three Software Approaches: DOS, NOS & Middleware"
    layout="card-grid"
    unit="BIT 542CO: Distributed & Cloud Computing"
  >
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 my-auto">
      <Card title="1. Distributed OS (DOS)" badge="One Kernel" glow="indigo">
        <p class="text-xs text-slate-700 font-bold mb-1">One unified operating system across all machines.</p>
        <p class="text-xs leading-relaxed text-slate-900 font-medium">
          The operating system manages all machines as if they were one. <em>Why it failed:</em> Every computer in the company had to run the exact same special OS. Real companies need different operating systems for different tasks.
        </p>
      </Card>

      <Card title="2. Network OS (NOS)" badge="Separate Kernels" glow="cyan">
        <p class="text-xs text-slate-700 font-bold mb-1">Standard operating systems with networking tools.</p>
        <p class="text-xs leading-relaxed text-slate-900 font-medium">
          Each computer runs standard Linux, Windows, or macOS. Users manually connect to remote machines using tools like SSH or file shares. Shows no transparency, but very flexible.
        </p>
      </Card>

      <Card title="3. Middleware" badge="The Winner" glow="amber">
        <p class="text-xs text-slate-700 font-bold mb-1">A helper software layer on top of standard operating systems.</p>
        <p class="text-xs leading-relaxed text-slate-900 font-medium">
          Runs on top of any standard OS to provide easy remote communication, database tools, and security. This is how modern web and cloud software is built.
        </p>
      </Card>
    </div>
    <SpeakerNotes>
      Explain why Middleware won: it allows a Windows laptop to talk to a Linux server and a cloud database without forcing all machines to run identical kernels.
    </SpeakerNotes>
  </Slide>

  <!-- ========================================================================
       SLIDE 12: SOFTWARE COMPARISON TABLE
       ======================================================================== -->
  <Slide
    id="software-table"
    eyebrow="SOFTWARE CONCEPTS"
    title="Comparing DOS, NOS, and Middleware"
    layout="table"
    unit="BIT 542CO: Distributed & Cloud Computing"
  >
    <div class="my-auto">
      <Table
        headers={["Feature", "Distributed OS (DOS)", "Network OS (NOS)", "Middleware Layer"]}
        rows={[
          ["Appearance to User", "Looks like one single computer", "Shows separate individual servers", "Hides network complexity via APIs"],
          ["Operating System Requirement", "Must be 100% identical on all nodes", "Can be different (Linux, Windows)", "Can be different on every node"],
          ["How Nodes Communicate", "Low-level kernel memory messages", "Explicit socket connections and files", "Remote function calls (RPC) and web APIs"],
          ["How Many Nodes It Can Handle", "Small clusters (tens of nodes)", "Medium networks (hundreds)", "Massive scale (millions of devices)"]
        ]}
      />
    </div>
    <SpeakerNotes>
      Walk students through why heterogeneity (differences in OS and hardware) made Middleware the industry standard.
    </SpeakerNotes>
  </Slide>

  <!-- ========================================================================
       SLIDE 13: WHAT MIDDLEWARE DOES
       ======================================================================== -->
  <Slide
    id="middleware-services"
    eyebrow="SOFTWARE CONCEPTS"
    title="What Does Middleware Do for Developers?"
    layout="split-sidebar"
    unit="BIT 542CO: Distributed & Cloud Computing"
  >
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 h-full">
      <div class="md:col-span-2 space-y-4">
        <p class="text-base leading-relaxed text-slate-900 font-medium">
          Instead of developers writing complex low-level network code for every app, <strong>middleware</strong> provides ready-to-use building blocks for common distributed tasks.
        </p>

        <div class="lecture-card border-2 border-slate-300 space-y-2">
          <h4 class="text-sm font-bold text-slate-950 uppercase">Common Middleware Services:</h4>
          <ul class="text-xs text-slate-900 space-y-1.5 pl-4 list-disc font-medium">
            <li><strong>Calling Remote Functions (RPC)</strong>: Running a function on another server as easily as calling a local function in your code.</li>
            <li><strong>Finding Services (Naming)</strong>: Looking up which server currently runs a specific service (like DNS or service discovery).</li>
            <li><strong>Handling Security</strong>: Verifying user logins and permissions across multiple servers using secure tokens.</li>
            <li><strong>Message Queues</strong>: Storing messages safely when thousands of requests arrive at once (like Apache Kafka).</li>
          </ul>
        </div>
      </div>

      <div class="md:col-span-1">
        <KeyTerms
          title="Terms"
          terms={[
            {
              term: "Middleware",
              definition: "Software between the operating system and applications that handles network communication."
            },
            {
              term: "RPC",
              definition: "Remote Procedure Call: calling a function on another computer over the network."
            },
            {
              term: "Message Queue",
              definition: "A buffer that holds messages until receiving servers are ready to process them."
            }
          ]}
        />
      </div>
    </div>
    <SpeakerNotes>
      Explain how tools like gRPC and Kafka are examples of modern middleware that students will use in their careers.
    </SpeakerNotes>
  </Slide>

  <!-- ========================================================================
       SLIDE 14: EIGHT FALSE ASSUMPTIONS (DEUTSCH)
       ======================================================================== -->
  <Slide
    id="eight-fallacies"
    eyebrow="DESIGN CHALLENGES"
    title="The Eight False Assumptions About Networks (Deutsch)"
    layout="table"
    unit="BIT 542CO: Distributed & Cloud Computing"
  >
    <div class="my-auto">
      <p class="text-sm text-slate-900 font-medium mb-3">
        New developers often make false assumptions that cause systems to fail in production:
      </p>

      <Table
        headers={["False Assumption", "The Real Truth", "What You Should Do"]}
        rows={[
          ["1. The network never fails", "Wi-Fi drops and switches restart often", "Always add timeout and retry logic"],
          ["2. Data travels instantly", "Signals take 50–150ms to cross oceans", "Do not block the screen while waiting"],
          ["3. Bandwidth is unlimited", "Cables get clogged during busy hours", "Send small, compact data packets"],
          ["4. The network is secure", "Anyone on public Wi-Fi can intercept data", "Always use HTTPS and encryption"],
          ["5. Network structure never changes", "Servers crash and new ones start dynamically", "Use service discovery tools"],
          ["6. There is only one administrator", "Data travels across companies and countries", "Use standard authentication tokens"],
          ["7. Moving data costs nothing", "Cloud providers charge fees for exported data", "Keep data transfers minimal"],
          ["8. All computers are identical", "Users have different phones, laptops, and OS", "Use standard data formats like JSON"]
        ]}
      />
    </div>
    <SpeakerNotes>
      Tell stories about apps that freeze when Wi-Fi drops because the developer assumed the network never fails.
    </SpeakerNotes>
  </Slide>

  <!-- ========================================================================
       SLIDE 15: DESIGN CHALLENGE - HETEROGENEITY
       ======================================================================== -->
  <Slide
    id="heterogeneity"
    eyebrow="DESIGN CHALLENGES"
    title="Challenge 1: Handling Different Types of Computers"
    layout="split-sidebar"
    unit="BIT 542CO: Distributed & Cloud Computing"
  >
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 h-full">
      <div class="md:col-span-2 space-y-4">
        <p class="text-base leading-relaxed text-slate-900 font-medium">
          A single system might connect an iPhone (ARM chip), a Windows desktop (x86 chip), and a Linux server. They store numbers in different byte orders and run different programming languages.
        </p>

        <div class="lecture-card border-2 border-slate-300 space-y-2">
          <h4 class="text-sm font-bold text-slate-950 uppercase">How We Solve This:</h4>
          <div class="space-y-2 text-xs text-slate-900 font-medium">
            <p class="m-0">
              <strong>1. Standard Data Formats</strong>: Instead of sending raw computer memory bytes, we convert data into standard formats like JSON or Protocol Buffers before sending it over the wire.
            </p>
            <p class="m-0">
              <strong>2. Clear Interface Rules</strong>: We define API inputs and outputs clearly so programs written in Python, Java, or C++ can understand each other without errors.
            </p>
          </div>
        </div>
      </div>

      <div class="md:col-span-1">
        <KeyTerms
          title="Terms"
          terms={[
            {
              term: "Heterogeneity",
              definition: "Having different brands of hardware, operating systems, and languages in one network."
            },
            {
              term: "Serialization",
              definition: "Converting a program object into a text or byte string to send over a network."
            },
            {
              term: "JSON",
              definition: "A standard text format readable by all programming languages."
            }
          ]}
        />
      </div>
    </div>
    <SpeakerNotes>
      Show an example of how JSON lets a Python script send data to a Java server seamlessly.
    </SpeakerNotes>
  </Slide>

  <!-- ========================================================================
       SLIDE 16: DESIGN CHALLENGE - SCALING BOTTLENECKS
       ======================================================================== -->
  <Slide
    id="scalability-bottlenecks"
    eyebrow="DESIGN CHALLENGES"
    title="Challenge 2: Avoiding Central Bottlenecks"
    layout="card-grid"
    unit="BIT 542CO: Distributed & Cloud Computing"
  >
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 my-auto">
      <Card title="One Central Server" badge="Bottleneck 1" glow="rose">
        <p class="text-xs text-slate-700 font-bold mb-1">Having one machine handle all logins.</p>
        <p class="text-xs leading-relaxed text-slate-900 font-medium mb-2">
          Works fine for 100 users, but crashes when 100,000 users try to log in at once. <em>Solution:</em> Run multiple login servers behind a load balancer.
        </p>
      </Card>

      <Card title="One Central Database File" badge="Bottleneck 2" glow="rose">
        <p class="text-xs text-slate-700 font-bold mb-1">Storing all user records on one hard disk.</p>
        <p class="text-xs leading-relaxed text-slate-900 font-medium mb-2">
          The hard disk becomes too slow to read all requests. <em>Solution:</em> Split data into shards across many database servers.
        </p>
      </Card>

      <Card title="Requiring Total Knowledge" badge="Bottleneck 3" glow="rose">
        <p class="text-xs text-slate-700 font-bold mb-1">Algorithms that require knowing the state of every computer.</p>
        <p class="text-xs leading-relaxed text-slate-900 font-medium mb-2">
          Asking 10,000 computers for their status causes massive network traffic. <em>Solution:</em> Have nodes talk only to their immediate neighbors.
        </p>
      </Card>
    </div>
    <SpeakerNotes>
      Explain how dividing work among many smaller servers prevents bottlenecks.
    </SpeakerNotes>
  </Slide>

  <!-- ========================================================================
       SLIDE 17: DESIGN CHALLENGE - HANDLING CRASHES
       ======================================================================== -->
  <Slide
    id="fault-tolerance"
    eyebrow="DESIGN CHALLENGES"
    title="Challenge 3: Handling Machine Crashes Gracefully"
    layout="split-sidebar"
    unit="BIT 542CO: Distributed & Cloud Computing"
  >
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 h-full">
      <div class="md:col-span-2 space-y-4">
        <p class="text-base leading-relaxed text-slate-900 font-medium">
          In large systems, hardware failures happen every day. A system is <strong>fault-tolerant</strong> if it continues serving users even when some servers crash.
        </p>

        <div class="lecture-card border-2 border-slate-300 space-y-2">
          <h4 class="text-sm font-bold text-slate-950 uppercase">How Systems Recover from Crashes:</h4>
          <ol class="text-xs text-slate-900 space-y-1.5 pl-4 list-decimal font-medium">
            <li><strong>Detecting the Problem</strong>: Servers send regular "heartbeat" signals. If a server stops answering, the system knows it failed.</li>
            <li><strong>Automatic Backup Copies</strong>: Important data is stored on at least 3 separate machines so losing one machine causes no data loss.</li>
            <li><strong>Stopping Domino Effects</strong>: If one service slows down, circuit breakers stop sending requests to it so the whole website does not freeze.</li>
          </ol>
        </div>
      </div>

      <div class="md:col-span-1">
        <KeyTerms
          title="Terms"
          terms={[
            {
              term: "Heartbeat",
              definition: "A periodic check message sent by servers to prove they are still running."
            },
            {
              term: "Circuit Breaker",
              definition: "Software pattern that stops calling a broken service to prevent cascading crashes."
            },
            {
              term: "Redundancy",
              definition: "Keeping duplicate backup servers ready to take over instantly."
            }
          ]}
        />
      </div>
    </div>
    <SpeakerNotes>
      Use the electrical fuse box analogy: a circuit breaker stops one failing appliance from setting the whole house on fire.
    </SpeakerNotes>
  </Slide>

