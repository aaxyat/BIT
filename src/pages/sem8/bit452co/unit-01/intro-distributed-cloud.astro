            },
            {
              term: "Serialization",
              definition: "Converting a computer object into a text or byte stream to send over the network."
            },
            {
              term: "JSON",
              definition: "A standard text data format understood by all programming languages."
            }
          ]}
        />
      </div>
    </div>
