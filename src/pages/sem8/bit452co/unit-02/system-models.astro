const messagePassingCode = `// Distributed Node Message Exchange Simulation
class DistributedNode {
  constructor(nodeId, networkLatencyMs = 25) {
    this.nodeId = nodeId;
    this.networkLatencyMs = networkLatencyMs;
    this.localState = new Map();
    this.peers = new Map();
  }

  registerPeer(peerNode) {
    this.peers.set(peerNode.nodeId, peerNode);
  }

  async send(targetNodeId, message) {
    const target = this.peers.get(targetNodeId);
    if (!target) throw new Error("Target " + targetNodeId + " unreachable");

    // Simulate physical network transit delay
    await new Promise((resolve) => setTimeout(resolve, this.networkLatencyMs));
    return target.receive(this.nodeId, message);
  }

  receive(senderId, message) {
    this.localState.set(message.key, message.value);
    return { status: "ACK", receiver: this.nodeId, appliedKey: message.key };
  }
}

const client = new DistributedNode("client-node", 15);
const server = new DistributedNode("server-node", 15);
client.registerPeer(server);
client.send("server-node", { key: "account_balance", value: 4500 });`;
---

<DeckLayout
