---
import X from 'lucide-astro/X';
import Keyboard from 'lucide-astro/Keyboard';

const shortcuts = [
  { key: 'Space / →', desc: 'Next slide / fragment' },
  { key: '←', desc: 'Previous slide / fragment' },
  { key: '↓ / ↑', desc: 'Drill down / up vertical slides' },
  { key: 'ESC / O', desc: 'Toggle slide overview grid' },
  { key: 'F', desc: 'Toggle fullscreen mode' },
  { key: 'S', desc: 'Open presenter speaker notes' },
  { key: 'B / .', desc: 'Pause / blackout presentation' },
  { key: 'Alt + Click', desc: 'Zoom into slide element' },
  { key: '? / H', desc: 'Toggle this shortcuts guide' },
];
---

<div
  id="shortcuts-modal"
  class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Keyboard Shortcuts"
>
  <div class="relative w-full max-w-lg rounded-xl bg-white p-6 shadow-2xl border-2 border-slate-300 text-slate-900">
    <div class="flex items-center justify-between pb-4 border-b-2 border-slate-200">
      <div class="flex items-center gap-2.5">
        <div class="p-2 rounded-lg bg-indigo-100 text-indigo-900 border border-indigo-200">
          <Keyboard class="w-5 h-5" />
        </div>
        <div>
          <h3 class="text-lg font-extrabold text-slate-900 m-0">Keyboard Shortcuts</h3>
          <p class="text-xs text-slate-600 font-semibold m-0">Classroom presentation controls</p>
        </div>
      </div>
      <button
        id="close-shortcuts-modal"
        class="p-2 rounded-lg hover:bg-slate-100 text-slate-500 hover:text-slate-900 transition-colors"
        aria-label="Close shortcuts dialog"
      >
        <X class="w-5 h-5" />
      </button>
    </div>

    <div class="mt-4 grid grid-cols-1 gap-2.5 max-h-[60vh] overflow-y-auto pr-1">
      {shortcuts.map((sc) => (
        <div class="flex items-center justify-between px-3 py-2 rounded-lg bg-slate-50 border border-slate-200">
          <span class="text-sm font-medium text-slate-800">{sc.desc}</span>
          <kbd class="px-2.5 py-1 text-xs font-mono font-bold text-indigo-950 bg-indigo-50 border-2 border-indigo-300 rounded shadow-sm">
            {sc.key}
          </kbd>
        </div>
      ))}
    </div>

    <div class="mt-5 pt-3 border-t-2 border-slate-200 flex justify-end">
      <button
        id="dismiss-shortcuts-btn"
        class="px-4 py-2 text-xs font-bold rounded-lg bg-indigo-700 hover:bg-indigo-800 text-white transition-all shadow-md"
      >
        Got it
      </button>
    </div>
  </div>
</div>

<script>
  function setupShortcutsModal() {
    const modal = document.getElementById('shortcuts-modal');
    const closeBtn = document.getElementById('close-shortcuts-modal');
    const dismissBtn = document.getElementById('dismiss-shortcuts-btn');

    const toggleModal = () => {
      modal?.classList.toggle('hidden');
    };

    closeBtn?.addEventListener('click', toggleModal);
    dismissBtn?.addEventListener('click', toggleModal);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.add('hidden');
      }
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === '?' || (e.key === 'h' && !(e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement))) {
        toggleModal();
      } else if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        modal.classList.add('hidden');
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupShortcutsModal);
  } else {
    setupShortcutsModal();
  }
  document.addEventListener('astro:page-load', setupShortcutsModal);
</script>
