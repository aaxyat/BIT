---
import X from 'lucide-astro/X';
import Keyboard from 'lucide-astro/Keyboard';

const shortcuts = [
  { key: 'Space / →', desc: 'Next slide / fragment' },
  { key: '←', desc: 'Previous slide / fragment' },
  { key: '↓ / ↑', desc: 'Drill down / up vertical slides' },
  { key: 'ESC / O', desc: 'Toggle slide overview grid' },
  { key: 'F', desc: 'Toggle fullscreen mode' },
  { key: 'S', desc: 'Open presenter speaker notes' },
  { key: 'B / .', desc: 'Pause / blackout presentation' },
  { key: 'Alt + Click', desc: 'Zoom into slide element' },
  { key: '? / H', desc: 'Toggle this shortcuts guide' },
];
---

<div
  id="shortcuts-modal"
  class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Keyboard Shortcuts"
>
  <div class="relative w-full max-w-lg rounded-2xl glass-panel p-6 shadow-2xl border border-white/10 text-white">
    <div class="flex items-center justify-between pb-4 border-b border-white/10">
      <div class="flex items-center gap-2.5">
        <div class="p-2 rounded-lg bg-indigo-500/20 text-indigo-400">
          <Keyboard class="w-5 h-5" />
        </div>
        <div>
          <h3 class="text-lg font-bold text-white m-0">Keyboard Shortcuts</h3>
          <p class="text-xs text-slate-400 m-0">Control your presentation effortlessly</p>
        </div>
      </div>
      <button
        id="close-shortcuts-modal"
        class="p-2 rounded-lg hover:bg-white/10 text-slate-400 hover:text-white transition-colors"
        aria-label="Close shortcuts dialog"
      >
        <X class="w-5 h-5" />
      </button>
    </div>

    <div class="mt-4 grid grid-cols-1 gap-2.5 max-h-[60vh] overflow-y-auto pr-1">
      {shortcuts.map((sc) => (
        <div class="flex items-center justify-between px-3 py-2 rounded-xl bg-slate-900/60 border border-white/5">
          <span class="text-sm text-slate-300">{sc.desc}</span>
          <kbd class="px-2.5 py-1 text-xs font-mono font-semibold text-indigo-300 bg-indigo-950/80 border border-indigo-500/30 rounded-md shadow-sm">
            {sc.key}
          </kbd>
        </div>
      ))}
    </div>

    <div class="mt-5 pt-3 border-t border-white/10 flex justify-end">
      <button
        id="dismiss-shortcuts-btn"
        class="px-4 py-2 text-xs font-semibold rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white transition-all shadow-md"
      >
        Got it
      </button>
    </div>
  </div>
</div>

<script>
  function setupShortcutsModal() {
    const modal = document.getElementById('shortcuts-modal');
    const closeBtn = document.getElementById('close-shortcuts-modal');
    const dismissBtn = document.getElementById('dismiss-shortcuts-btn');

    const toggleModal = () => {
      modal?.classList.toggle('hidden');
    };

    closeBtn?.addEventListener('click', toggleModal);
    dismissBtn?.addEventListener('click', toggleModal);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.add('hidden');
      }
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === '?' || (e.key === 'h' && !(e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement))) {
        toggleModal();
      } else if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        modal.classList.add('hidden');
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupShortcutsModal);
  } else {
    setupShortcutsModal();
  }
  document.addEventListener('astro:page-load', setupShortcutsModal);
</script>
