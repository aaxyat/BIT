---
import ArrowLeft from 'lucide-astro/ArrowLeft';
import HelpCircle from 'lucide-astro/HelpCircle';
import Grid from 'lucide-astro/Grid';
import Maximize2 from 'lucide-astro/Maximize2';
import ChevronLeft from 'lucide-astro/ChevronLeft';
import ChevronRight from 'lucide-astro/ChevronRight';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header class="fixed top-0 left-0 right-0 z-50 px-6 py-3 flex items-center justify-between pointer-events-none transition-opacity duration-300">
  <div class="flex items-center gap-3 pointer-events-auto">
    <a
      href="/"
      class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white hover:bg-slate-100 border-2 border-slate-300 text-xs font-bold text-slate-800 hover:text-slate-950 transition-all shadow-sm"
      title="Home"
    >
      <ArrowLeft class="w-3.5 h-3.5" />
      <span>Home</span>
    </a>
    <div class="h-4 w-px bg-slate-300 hidden sm:block"></div>
    <span class="text-xs font-extrabold text-slate-800 tracking-wide hidden sm:block">
      {title}
    </span>
  </div>

  <div class="flex items-center gap-2 pointer-events-auto">
    <div class="flex items-center rounded-lg bg-white border-2 border-slate-300 shadow-sm overflow-hidden mr-1">
      <button
        id="deck-btn-prev"
        class="px-2.5 py-1.5 hover:bg-slate-100 text-slate-800 hover:text-slate-950 transition-all text-xs font-bold border-r border-slate-200 flex items-center gap-1"
        title="Previous Slide (Left Arrow / Space+Shift)"
      >
        <ChevronLeft class="w-4 h-4" />
        <span class="hidden md:inline">Prev</span>
      </button>
      <button
        id="deck-btn-next"
        class="px-2.5 py-1.5 hover:bg-slate-100 text-slate-800 hover:text-slate-950 transition-all text-xs font-bold flex items-center gap-1"
        title="Next Slide (Right Arrow / Space)"
      >
        <span class="hidden md:inline">Next</span>
        <ChevronRight class="w-4 h-4" />
      </button>
    </div>

    <button
      id="deck-btn-overview"
      class="p-2 rounded-lg bg-white hover:bg-slate-100 border-2 border-slate-300 text-slate-800 hover:text-slate-950 transition-all shadow-sm text-xs font-bold"
      title="Overview (ESC)"
    >
      <Grid class="w-3.5 h-3.5" />
    </button>
    <button
      id="deck-btn-fullscreen"
      class="p-2 rounded-lg bg-white hover:bg-slate-100 border-2 border-slate-300 text-slate-800 hover:text-slate-950 transition-all shadow-sm text-xs font-bold"
      title="Toggle Fullscreen (F)"
    >
      <Maximize2 class="w-3.5 h-3.5" />
    </button>
    <button
      id="deck-btn-help"
      class="p-2 rounded-lg bg-white hover:bg-slate-100 border-2 border-slate-300 text-slate-800 hover:text-slate-950 transition-all shadow-sm text-xs font-bold"
      title="Shortcuts (?)"
    >
      <HelpCircle class="w-3.5 h-3.5" />
    </button>
  </div>
</header>

<script>
  function setupHeaderControls() {
    const prevBtn = document.getElementById('deck-btn-prev');
    const nextBtn = document.getElementById('deck-btn-next');
    const overviewBtn = document.getElementById('deck-btn-overview');
    const fullscreenBtn = document.getElementById('deck-btn-fullscreen');
    const helpBtn = document.getElementById('deck-btn-help');

    prevBtn?.addEventListener('click', () => {
      // @ts-ignore
      if (window.Reveal) {
        // @ts-ignore
        window.Reveal.prev();
      }
    });

    nextBtn?.addEventListener('click', () => {
      // @ts-ignore
      if (window.Reveal) {
        // @ts-ignore
        window.Reveal.next();
      }
    });

    overviewBtn?.addEventListener('click', () => {
      // @ts-ignore
      if (window.Reveal) {
        // @ts-ignore
        window.Reveal.toggleOverview();
      }
    });

    fullscreenBtn?.addEventListener('click', () => {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().catch(() => {});
      } else {
        document.exitFullscreen().catch(() => {});
      }
    });

    helpBtn?.addEventListener('click', () => {
      const modal = document.getElementById('shortcuts-modal');
      if (modal) {
        const isHidden = modal.style.display === 'none' || modal.classList.contains('hidden');
        if (isHidden) {
          modal.style.display = 'flex';
          modal.classList.remove('hidden');
        } else {
          modal.style.display = 'none';
          modal.classList.add('hidden');
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHeaderControls);
  } else {
    setupHeaderControls();
  }
  document.addEventListener('astro:page-load', setupHeaderControls);
</script>
