---
import { ArrowLeft, HelpCircle, Grid, Maximize2 } from 'lucide-astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header class="fixed top-0 left-0 right-0 z-50 px-6 py-3.5 flex items-center justify-between pointer-events-none transition-opacity duration-300">
  <div class="flex items-center gap-3 pointer-events-auto">
    <a
      href="/"
      class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-900/80 hover:bg-slate-800/90 border border-white/10 text-xs font-medium text-slate-300 hover:text-white transition-all shadow-sm backdrop-blur-md"
      title="Return to Decks Dashboard"
    >
      <ArrowLeft class="w-3.5 h-3.5" />
      <span>Decks</span>
    </a>
    <div class="h-4 w-px bg-white/10 hidden sm:block"></div>
    <span class="text-xs font-semibold text-slate-300/90 tracking-wide hidden sm:block">
      {title}
    </span>
  </div>

  <div class="flex items-center gap-2 pointer-events-auto">
    <button
      id="deck-btn-overview"
      class="p-2 rounded-lg bg-slate-900/80 hover:bg-slate-800/90 border border-white/10 text-slate-300 hover:text-white transition-all shadow-sm backdrop-blur-md text-xs"
      title="Slide Overview (ESC)"
    >
      <Grid class="w-3.5 h-3.5" />
    </button>
    <button
      id="deck-btn-fullscreen"
      class="p-2 rounded-lg bg-slate-900/80 hover:bg-slate-800/90 border border-white/10 text-slate-300 hover:text-white transition-all shadow-sm backdrop-blur-md text-xs"
      title="Toggle Fullscreen (F)"
    >
      <Maximize2 class="w-3.5 h-3.5" />
    </button>
    <button
      id="deck-btn-help"
      class="p-2 rounded-lg bg-slate-900/80 hover:bg-slate-800/90 border border-white/10 text-slate-300 hover:text-white transition-all shadow-sm backdrop-blur-md text-xs"
      title="Keyboard Shortcuts (?)"
    >
      <HelpCircle class="w-3.5 h-3.5" />
    </button>
  </div>
</header>

<script>
  function setupHeaderControls() {
    const overviewBtn = document.getElementById('deck-btn-overview');
    const fullscreenBtn = document.getElementById('deck-btn-fullscreen');
    const helpBtn = document.getElementById('deck-btn-help');

    overviewBtn?.addEventListener('click', () => {
      // @ts-ignore
      if (window.Reveal) {
        // @ts-ignore
        window.Reveal.toggleOverview();
      }
    });

    fullscreenBtn?.addEventListener('click', () => {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().catch(() => {});
      } else {
        document.exitFullscreen().catch(() => {});
      }
    });

    helpBtn?.addEventListener('click', () => {
      const modal = document.getElementById('shortcuts-modal');
      if (modal) {
        modal.classList.toggle('hidden');
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHeaderControls);
  } else {
    setupHeaderControls();
  }
  document.addEventListener('astro:page-load', setupHeaderControls);
</script>
