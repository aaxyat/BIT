---
import { Play, Sparkles, Clock, Layers } from 'lucide-astro';

interface Props {
  title: string;
  description: string;
  slug: string;
  category: string;
  slideCount: number;
  duration: string;
  glow?: 'indigo' | 'cyan' | 'rose' | 'amber';
  featured?: boolean;
}

const {
  title,
  description,
  slug,
  category,
  slideCount,
  duration,
  glow = 'indigo',
  featured = false,
} = Astro.props;

const borderGlow = {
  indigo: 'hover:border-indigo-500/50 hover:shadow-indigo-500/15',
  cyan: 'hover:border-cyan-500/50 hover:shadow-cyan-500/15',
  rose: 'hover:border-rose-500/50 hover:shadow-rose-500/15',
  amber: 'hover:border-amber-500/50 hover:shadow-amber-500/15',
};

const categoryBadge = {
  indigo: 'bg-indigo-500/10 text-indigo-300 border-indigo-500/30',
  cyan: 'bg-cyan-500/10 text-cyan-300 border-cyan-500/30',
  rose: 'bg-rose-500/10 text-rose-300 border-rose-500/30',
  amber: 'bg-amber-500/10 text-amber-300 border-amber-500/30',
};
---

<div
  class={`group relative flex flex-col justify-between p-6 rounded-2xl glass-card border border-white/10 shadow-xl transition-all duration-300 ${borderGlow[glow]} ${featured ? 'md:col-span-2 bg-slate-900/70' : ''}`}
  data-category={category.toLowerCase()}
>
  <div>
    <div class="flex items-center justify-between gap-2 mb-4">
      <span class={`text-xs font-semibold px-3 py-1 rounded-full border ${categoryBadge[glow]}`}>
        {category}
      </span>
      <div class="flex items-center gap-3 text-xs text-slate-400 font-mono">
        <span class="flex items-center gap-1">
          <Layers class="w-3.5 h-3.5 text-slate-400" />
          {slideCount} slides
        </span>
        <span>•</span>
        <span class="flex items-center gap-1">
          <Clock class="w-3.5 h-3.5 text-slate-400" />
          {duration}
        </span>
      </div>
    </div>

    <h3 class="text-2xl font-bold text-white group-hover:text-indigo-300 transition-colors mb-2 tracking-tight">
      {title}
    </h3>
    <p class="text-sm text-slate-300/80 leading-relaxed mb-6">
      {description}
    </p>
  </div>

  <div class="pt-4 border-t border-white/5 flex items-center justify-between">
    <a
      href={`/decks/${slug}`}
      class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold tracking-wide transition-all shadow-md group-hover:shadow-indigo-500/25 group-hover:translate-x-0.5"
    >
      <span>Launch Deck</span>
      <Play class="w-3.5 h-3.5 fill-current" />
    </a>
    <span class="text-xs font-mono text-slate-500">/decks/{slug}</span>
  </div>
</div>
