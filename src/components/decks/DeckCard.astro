---
import Play from 'lucide-astro/Play';
import Clock from 'lucide-astro/Clock';
import Layers from 'lucide-astro/Layers';

interface Props {
  title: string;
  description: string;
  slug: string;
  category: string;
  slideCount: number;
  duration: string;
  glow?: 'indigo' | 'cyan' | 'rose' | 'amber';
  featured?: boolean;
}

const {
  title,
  description,
  slug,
  category,
  slideCount,
  duration,
  glow = 'indigo',
  featured = false,
} = Astro.props;

const categoryBadge = {
  indigo: 'bg-indigo-100 text-indigo-900 border-indigo-300',
  cyan: 'bg-teal-100 text-teal-900 border-teal-300',
  rose: 'bg-rose-100 text-rose-900 border-rose-300',
  amber: 'bg-amber-100 text-amber-900 border-amber-300',
};
---

<div
  class={`group relative flex flex-col justify-between p-6 rounded-xl bg-white border-2 border-slate-300 shadow-md hover:border-indigo-600 transition-all duration-200 ${featured ? 'md:col-span-2 bg-gradient-to-br from-white to-slate-50' : ''}`}
>
  <div>
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class={`text-xs font-bold px-3 py-0.5 rounded-full border ${categoryBadge[glow]}`}>
        {category}
      </span>
      <div class="flex items-center gap-3 text-xs text-slate-600 font-bold">
        <span class="flex items-center gap-1">
          <Layers class="w-3.5 h-3.5 text-slate-500" />
          {slideCount} slides
        </span>
        <span>•</span>
        <span class="flex items-center gap-1">
          <Clock class="w-3.5 h-3.5 text-slate-500" />
          {duration}
        </span>
      </div>
    </div>

    <h3 class="text-xl font-extrabold text-slate-950 group-hover:text-indigo-900 transition-colors mb-2 tracking-tight">
      {title}
    </h3>
    <p class="text-sm text-slate-700 font-medium leading-relaxed mb-6">
      {description}
    </p>
  </div>

  <div class="pt-4 border-t-2 border-slate-100 flex items-center justify-between">
    <a
      href={`/decks/${slug}`}
      class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-indigo-700 hover:bg-indigo-800 text-white text-xs font-bold tracking-wide transition-all shadow-sm group-hover:translate-x-0.5"
    >
      <span>Present Deck</span>
      <Play class="w-3.5 h-3.5 fill-current" />
    </a>
    <span class="text-xs font-mono font-bold text-slate-500">/decks/{slug}</span>
  </div>
</div>
