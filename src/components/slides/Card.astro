---
interface Props {
  title?: string;
  badge?: string;
  stat?: string;
  statLabel?: string;
  glow?: 'indigo' | 'cyan' | 'rose' | 'amber';
  class?: string;
}

const {
  title,
  badge,
  stat,
  statLabel,
  glow = 'indigo',
  class: className = '',
} = Astro.props;

const glowClasses = {
  indigo: 'hover:border-indigo-500/50 hover:shadow-indigo-500/20',
  cyan: 'hover:border-cyan-500/50 hover:shadow-cyan-500/20',
  rose: 'hover:border-rose-500/50 hover:shadow-rose-500/20',
  amber: 'hover:border-amber-500/50 hover:shadow-amber-500/20',
};

const badgeGlow = {
  indigo: 'bg-indigo-500/10 text-indigo-300 border-indigo-500/30',
  cyan: 'bg-cyan-500/10 text-cyan-300 border-cyan-500/30',
  rose: 'bg-rose-500/10 text-rose-300 border-rose-500/30',
  amber: 'bg-amber-500/10 text-amber-300 border-amber-500/30',
};
---

<div
  class={`glass-card p-6 rounded-2xl border border-white/10 shadow-lg transition-all duration-300 ${glowClasses[glow]} ${className}`}
>
  {(badge || title) && (
    <div class="flex items-center justify-between mb-3 gap-2">
      {title && <h3 class="text-xl font-bold text-white tracking-tight m-0">{title}</h3>}
      {badge && (
        <span class={`text-xs font-semibold px-2.5 py-1 rounded-full border ${badgeGlow[glow]}`}>
          {badge}
        </span>
      )}
    </div>
  )}

  {stat && (
    <div class="my-3">
      <div class="text-4xl font-extrabold text-gradient">{stat}</div>
      {statLabel && <div class="text-xs text-slate-400 font-medium mt-1">{statLabel}</div>}
    </div>
  )}

  <div class="text-slate-300 text-sm leading-relaxed">
    <slot />
  </div>
</div>
