---
interface Props {
  title?: string;
  badge?: string;
  glow?: 'indigo' | 'cyan' | 'rose' | 'amber';
  class?: string;
}

const {
  title,
  badge,
  glow = 'indigo',
  class: className = '',
} = Astro.props;

const badgeStyles = {
  indigo: 'bg-indigo-100 text-indigo-900 border-indigo-300',
  cyan: 'bg-teal-100 text-teal-900 border-teal-300',
  rose: 'bg-rose-100 text-rose-900 border-rose-300',
  amber: 'bg-amber-100 text-amber-900 border-amber-300',
};

const borderStyles = {
  indigo: 'border-slate-300 hover:border-indigo-500',
  cyan: 'border-slate-300 hover:border-teal-500',
  rose: 'border-slate-300 hover:border-rose-500',
  amber: 'border-slate-300 hover:border-amber-500',
};
---

<div
  class={`lecture-card border-2 ${borderStyles[glow]} transition-colors duration-200 ${className}`}
>
  {(badge || title) && (
    <div class="flex items-center justify-between mb-2.5 gap-2 border-b border-slate-200 pb-2">
      {title && <h3 class="text-lg font-bold text-slate-950 tracking-tight m-0">{title}</h3>}
      {badge && (
        <span class={`text-xs font-bold px-2.5 py-0.5 rounded-full border ${badgeStyles[glow]}`}>
          {badge}
        </span>
      )}
    </div>
  )}

  <div class="text-slate-900 text-sm leading-relaxed font-medium">
    <slot />
  </div>
</div>
