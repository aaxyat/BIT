---
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  layout?: 'default' | 'split-sidebar' | 'card-grid' | 'table' | 'code' | 'cover' | 'center';
  unit?: string;
  bgScene?: 'particles' | 'grid' | 'geometry' | 'constellation' | 'none';
  transition?: 'slide' | 'fade' | 'convex' | 'concave' | 'zoom' | 'none';
  class?: string;
}

const {
  id,
  eyebrow,
  title,
  subtitle,
  layout = 'default',
  unit,
  bgScene = 'none',
  transition,
  class: className = '',
} = Astro.props;

const layoutClass = `slide-layout-${layout}`;
---

<section
  id={id}
  class={`relative w-full h-full ${layoutClass} ${className}`}
  data-bg-scene={bgScene}
  data-transition={transition}
>
  {(eyebrow || title) && (
    <div class="slide-header">
      {eyebrow && <div class="slide-eyebrow">{eyebrow}</div>}
      {title && <h2 class="font-extrabold text-slate-950 tracking-tight m-0">{title}</h2>}
      {subtitle && <p class="text-slate-700 text-sm font-semibold mt-1 mb-0">{subtitle}</p>}
    </div>
  )}

  <div class="slide-content">
    <slot />
  </div>

  {unit && (
    <div class="slide-footer">
      <span>{unit}</span>
    </div>
  )}
</section>
