---
import AlertTriangle from 'lucide-astro/AlertTriangle';
import Terminal from 'lucide-astro/Terminal';

interface Props {
  code: string;
  lang?: string;
  lines?: string;
  title?: string;
  output?: string;
  pitfalls?: string[];
  class?: string;
}

const {
  code,
  lang = 'typescript',
  lines,
  title,
  output,
  pitfalls = [],
  class: className = '',
} = Astro.props;

const trimmedCode = code.trim();
---

<div class={`space-y-3 my-2 ${className}`}>
  <!-- Code Editor Window -->
  <div class="rounded-lg overflow-hidden border-2 border-slate-300 bg-slate-100 shadow-sm">
    {title && (
      <div class="bg-slate-200 px-4 py-2 border-b-2 border-slate-300 flex items-center justify-between text-xs font-mono">
        <div class="flex items-center gap-2">
          <div class="flex gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-rose-400 inline-block border border-rose-500"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-amber-400 inline-block border border-amber-500"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 inline-block border border-emerald-500"></span>
          </div>
          <span class="font-bold text-slate-800 ml-2">{title}</span>
        </div>
        <span class="text-indigo-900 font-extrabold uppercase bg-indigo-100 px-2 py-0.5 rounded border border-indigo-300">{lang}</span>
      </div>
    )}
    <pre class="m-0 !bg-slate-50"><code
      class={`language-${lang} text-sm font-medium`}
      data-trim
      data-noescape
      data-line-numbers={lines}
    >{trimmedCode}</code></pre>
  </div>

  <!-- Expected Output & Pitfalls Grid -->
  {(output || pitfalls.length > 0) && (
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs">
      {output && (
        <div class="p-3 rounded-lg bg-slate-100 border-2 border-slate-300">
          <div class="flex items-center gap-1.5 font-bold text-slate-900 mb-1.5 uppercase tracking-wide">
            <Terminal class="w-4 h-4 text-indigo-700" />
            <span>Expected Output</span>
          </div>
          <pre class="m-0 p-2 bg-white rounded border border-slate-300 font-mono text-slate-900 text-xs">{output.trim()}</pre>
        </div>
      )}

      {pitfalls.length > 0 && (
        <div class="p-3 rounded-lg bg-amber-50 border-2 border-amber-300">
          <div class="flex items-center gap-1.5 font-bold text-amber-950 mb-1.5 uppercase tracking-wide">
            <AlertTriangle class="w-4 h-4 text-amber-700" />
            <span>Common Student Mistakes</span>
          </div>
          <ul class="m-0 pl-4 space-y-1 text-amber-950 font-medium list-disc">
            {pitfalls.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      )}
    </div>
  )}
</div>
