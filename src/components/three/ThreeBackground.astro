---
interface Props {
  initialScene?: 'particles' | 'grid' | 'geometry' | 'constellation' | 'none';
}

const { initialScene = 'none' } = Astro.props;
---

<div id="three-bg-container" data-initial-scene={initialScene} class="fixed inset-0 pointer-events-none -z-10 overflow-hidden select-none" aria-hidden="true">
  <canvas id="three-bg-canvas" class="w-full h-full block"></canvas>
</div>

<script>
  import { SceneManager } from './scenes/SceneManager';

  function initThreeBackground() {
    const canvas = document.getElementById('three-bg-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    // Check if already initialized
    if (window.__sceneManager) {
      return;
    }

    const container = document.getElementById('three-bg-container');
    const initial = container?.dataset.initialScene || 'none';
    new SceneManager(canvas, initial);
  }

  // Initialize on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initThreeBackground);
  } else {
    initThreeBackground();
  }

  // Support Astro page transitions if present
  document.addEventListener('astro:page-load', initThreeBackground);
</script>
